# UI settings that survive a restart. Key -> (type, default value).
UI_SETTINGS = {
    "sort": (str, "chip"),
    "interval": (float, 2.0),
    "fahrenheit": (bool, False),
    "temps_only": (bool, False),
    "hide_duplicates": (bool, False),
    "show_dead": (bool, False),
    "hide_stale": (bool, False),
    "mono": (bool, False),
    "ascii": (bool, False),
    "window": (int, 0),  # index into WINDOWS: 0 = sample, 1 = 30 s, 2 = 5 min
    "dual": (bool, False),  # right panel: sensor history or the chip panel
    "selected": (str, ""),  # the selected sensor as "chip/label"
}
TEMP_SETTINGS = {
    "range": (str, "auto:130"),
    "floor_margin": (float, TEMP_FLOOR_MARGIN),
    "dead_after": (int, 20),
}


@dataclass
class Config:
    """The contents of config.toml: aliases, the hidden list and the UI settings."""

    path: str = CONFIG_PATH
    ui: dict = field(default_factory=dict)
    temps: dict = field(default_factory=dict)
    aliases: list = field(default_factory=list)  # [(pattern, alias)]
    hidden: list = field(default_factory=list)  # "chip/label" patterns
    priorities: list = field(default_factory=list)  # [(pattern, class)]
    error: Optional[str] = None
    exists: bool = False
    alias_notes: dict = field(default_factory=dict)  # chip -> comment with the kinds

    @classmethod
    def load(cls, path: str = CONFIG_PATH) -> "Config":
        cfg = cls(path=path)
        # a --config pointing at an old .conf file still means aliases only
        if path.endswith(".conf"):
            cfg.aliases = load_aliases(path)
            cfg.exists = os.path.exists(path)
            return cfg
        raw, cfg.error = _read_toml(path)
        cfg.exists = raw is not None
        raw = raw or {}
        cfg.ui = _typed(raw.get("ui"), UI_SETTINGS)
        if cfg.ui.get("sort") not in SORTS:  # argparse `choices` does not cover the file
            cfg.ui.pop("sort", None)
        cfg.temps = _typed(raw.get("temps"), TEMP_SETTINGS)
        aliases = raw.get("aliases")
        if isinstance(aliases, dict):
            cfg.aliases = [(str(k), str(v)) for k, v in aliases.items() if k and v]
        hidden_table = raw.get("hidden")
        hidden = hidden_table.get("sensors") if isinstance(hidden_table, dict) else None
        if isinstance(hidden, list):
            cfg.hidden = [str(x) for x in hidden if x]
        prio = raw.get("priorities")
        if isinstance(prio, dict):
            # the class has to be an integer - a typo should be skipped rather
            # than upend the ordering of the sensor list
            cfg.priorities = [
                (str(k), int(v))
                for k, v in prio.items()
                if k and isinstance(v, int) and not isinstance(v, bool)
            ]
        if not cfg.aliases:  # migration from an aliases.conf sitting next to it
            cfg.aliases = load_aliases(os.path.join(os.path.dirname(path) or ".", "aliases.conf"))
        return cfg

    def save(self) -> None:
        """Writes the whole file. User comments do not survive a save."""
        if self.path.endswith(".conf"):
            # load() reads .conf as `pattern = alias` lines, so TOML here would
            # destroy the aliases and the settings would not come back
            raise OSError("a .conf file holds aliases only - use --config with a .toml path")
        os.makedirs(os.path.dirname(self.path) or ".", exist_ok=True)
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write(self.dumps())
        os.replace(tmp, self.path)  # atomic write - never half a file
        self.exists = True

    def dumps(self) -> str:
        out = [
            "# sensortop - configuration",
            f"# Saved {time.strftime('%Y-%m-%d %H:%M:%S')} (the `W` key in the TUI).",
            "",
            "[ui]",
        ]
        for key, (_typ, default) in UI_SETTINGS.items():
            if key == "ascii":
                out.append("# ascii = true forces ASCII charts instead of braille")
            elif key == "window":
                out.append("# window: the history window - 0 = sample, 1 = 30 s, 2 = 5 min")
            elif key == "dual":
                out.append("# dual = true opens the right panel as the chip panel (the `u` key)")
            elif key == "selected":
                out.append('# selected: the selected sensor as "chip/label". When it is missing')
                out.append("# from the current set, the choice falls back to the [priorities] ranking.")
            out.append(f"{key} = {_toml_val(self.ui.get(key, default))}")
        out += [
            "",
            "[temps]",
            "# range: MIN:MAX in °C. MIN = auto -> the floor is computed from the",
            "# trustworthy sensors (the coldest of them minus floor_margin),",
            "# instead of a fixed value.",
        ]
        for key, (_typ, default) in TEMP_SETTINGS.items():
            out.append(f"{key} = {_toml_val(self.temps.get(key, default))}")
        out += [
            "",
            "[aliases]",
            "# \"fnmatch pattern\" = \"alias\"  (the longest pattern wins)",
        ]
        for pat, alias in self.aliases:
            note = self.alias_notes.get(pat)
            if note:
                out.append(f"# {pat}: {note}")
            out.append(f"{_toml_val(pat)} = {_toml_val(alias)}")
        out += [
            "",
            "[priorities]",
            "# Sensor role ranking: decides what is selected at startup and which",
            "# series reach the chip panel (`u`). A lower number = more important,",
            f"# a sensor outside the map gets class {PRIORITY_FALLBACK}. The value and the limit",
            "# only decide within a class - hwmon limits are not comparable across chips.",
            '# Key: "chip pattern/label" (fnmatch, as in [hidden]).',
        ]
        out += [f"{_toml_val(pat)} = {cls:d}" for pat, cls in self.priorities]
        out += [
            "",
            "[hidden]",
            "# Sensors hidden manually (the `x` key), as \"chip/label\";",
            "# fnmatch patterns work, e.g. \"nct6799-*/AUXTIN*\".",
            "sensors = [",
        ]
        out += [f"  {_toml_val(p)}," for p in self.hidden]
        out += ["]", ""]
        return "\n".join(out)


def _read_toml(path: str) -> tuple[Optional[dict], Optional[str]]:
    """Returns (data, error). A missing file is not an error - just no data."""
    try:
        import tomllib
    except ImportError:  # Python < 3.11
        if not os.path.exists(path):
            return None, None
        return None, f"{path}: requires Python 3.11+ (tomllib) - configuration skipped"
    try:
        with open(path, "rb") as fh:
            return tomllib.load(fh), None
    except FileNotFoundError:
        return None, None
    except OSError as exc:
        return None, f"{path}: {exc.strerror}"
    except Exception as exc:  # noqa: BLE001 - tomllib.TOMLDecodeError
        return None, f"{path}: {exc}"


def _typed(section, spec: dict) -> dict:
    """Lets through only known keys of a matching type - a typo cannot crash the TUI."""
    if not isinstance(section, dict):
        return {}
    out = {}
    for key, value in section.items():
        if key not in spec:
            continue
        typ = spec[key][0]
        if typ is bool and isinstance(value, bool):
            out[key] = value
        elif typ is float and isinstance(value, (int, float)) and not isinstance(value, bool):
            out[key] = float(value)
        elif typ is int and isinstance(value, int) and not isinstance(value, bool):
            out[key] = value
        elif typ is str and isinstance(value, str):
            out[key] = value
    return out


def _toml_val(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, (list, tuple)):
        return "[" + ", ".join(_toml_val(x) for x in v) + "]"
    return '"' + str(v).replace("\\", "\\\\").replace('"', '\\"') + '"'


class ChipNamer:
    """Gives chips readable names and resolves collisions (two amdgpu, two spd5118)."""

    def __init__(self, user_rules: Optional[list[tuple[str, str]]] = None):
        # the user rules first, then the built-in ones; within each group the
        # longer (more specific) pattern takes precedence
        user = sorted(user_rules or [], key=lambda kv: -len(kv[0]))
        builtin = sorted(DEFAULT_ALIASES, key=lambda kv: -len(kv[0]))
        self.rules = user + builtin
        self._cache: dict[str, str] = {}

    def base_alias(self, chip: str) -> Optional[str]:
        for pat, alias in self.rules:
            if fnmatch.fnmatch(chip, pat):
                return alias
        return None

    def rebuild(self, chips) -> None:
        """Computes the aliases for a set of chips, adding a suffix on collision."""
        chips = list(dict.fromkeys(chips))
        groups: dict[str, list[str]] = {}
        for chip in chips:
            groups.setdefault(self.base_alias(chip) or short_chip(chip), []).append(chip)
        cache: dict[str, str] = {}
        for name, members in groups.items():
            if len(members) == 1:
                cache[members[0]] = name
                continue
            for chip, suffix in zip(members, distinct_suffixes(members)):
                cache[chip] = f"{name}/{suffix}"
        self._cache = cache

    def alias(self, chip: str) -> str:
        if chip not in self._cache:
            self.rebuild(list(self._cache) + [chip])
        return self._cache.get(chip, short_chip(chip))

    def qualified(self, r: Reading) -> str:
        """The sensor name with its chip context, e.g. 'GPU/mem'."""
        return f"{self.alias(r.chip)}/{r.label}"


def chip_suffix(chip: str) -> str:
    """The fragment distinguishing chips of the same type (e.g. pci-0300 -> 0300)."""
    m = re.search(r"(?:pci|i2c|isa|acpi|mdio)[-_]([0-9a-f:.-]+)$", chip, re.I)
    if m:
        return m.group(1).split("-")[-1]
    return chip.rsplit("-", 1)[-1]


def distinct_suffixes(chips: list[str]) -> list[str]:
    """Suffixes telling apart chips that share a name, unique within the list."""
    short = [chip_suffix(c) for c in chips]
    if len(set(short)) == len(chips):
        return short
    # the short form collides (spd5118-i2c-0-50 / -1-50): keep the fields that differ
    fields = [c.split("-") for c in chips]
    if len({len(f) for f in fields}) > 1:
        return list(chips)
    keep = [i for i, col in enumerate(zip(*fields)) if len(set(col)) > 1]
    return ["-".join(f[i] for i in keep) for f in fields]


def short_chip(chip: str) -> str:
    """Shortens a chip name that has no alias: r8169_0_a00:00-mdio-0 -> r8169_0_a00."""
    return chip.split(":")[0].split("-")[0][:14] or chip


def detected_aliases(namer: ChipNamer, chips) -> list[tuple[str, str]]:
    """Base aliases of the detected chips - a starting point for the config file.

    Base, i.e. without the collision-breaking suffix: after one line is edited
    (GPU -> iGPU) the other no longer needs a suffix and returns to a clean name.
    """
    return [(chip, namer.base_alias(chip) or short_chip(chip)) for chip in dict.fromkeys(chips)]


def sensor_id(r: Reading) -> str:
    """The sensor identity in the config: "chip/label" (like the [hidden] patterns)."""
    return f"{r.chip}/{r.label}"


class PriorityMap:
    """The importance class of a sensor, derived from the (chip, label) pair.

    The patterns work as in [hidden] - fnmatch on "chip/label" - and the most
    specific (longest) one wins; rules from the config beat the built-in ones.
    To demote a built-in entry it is enough to give it a higher class; nothing
    has to be removed.
    """

    def __init__(self, user_rules=None, builtin=None):
        base = DEFAULT_PRIORITIES if builtin is None else builtin
        user = sorted(user_rules or [], key=lambda kv: -len(kv[0]))
        self.rules = user + sorted(base, key=lambda kv: -len(kv[0]))

    def klass(self, r: Reading) -> int:
        name = sensor_id(r)
        for pat, cls in self.rules:
            if fnmatch.fnmatch(name, pat):
                return cls
        return PRIORITY_FALLBACK


def rank_key(r: Reading, cls: int, ratio: Optional[float]) -> tuple:
    """The ranking key: class, kind, bar fill, identity.

    The kind comes before the reading because the "rest" class holds
    temperatures and fans side by side, and 80% of maximum RPM does not mean
    the same as 80% of the way to a limit. The chip and label close out ties -
    it has to resolve the same way on every run, not by the hwmon order.
    """
    return (cls, KIND_ORDER.get(r.kind, 9), -(ratio or 0.0), r.chip, r.label)


