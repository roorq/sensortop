SORTS = ["chip", "value", "name"]
SORT_LABELS = {"chip": "chip", "value": "value", "name": "name"}


class App:
    def __init__(self, source, args, cfg: Optional[Config] = None):
        self.src = source
        self.cfg = cfg or Config.load(getattr(args, "config", CONFIG_PATH))
        self.interval = args.interval
        self.fahrenheit = args.fahrenheit
        self.temps_only = args.temps_only
        self.mono = getattr(args, "mono", False)
        self.theme = Theme(False)
        self.stats: dict[str, Stats] = {}
        self.readings: list[Reading] = []
        self.rows: list[tuple] = []  # ("chip", name) or ("sensor", Reading)
        self.sel = 0
        # the startup selection: the saved sensor, and when it is missing, the
        # top of the role ranking. It is restored once, on the first non-empty
        # set; after that the arrow keys belong to the user.
        self.want_sel = getattr(args, "selected", "") or ""
        self.sel_restored = False
        self.offset = 0
        self.sort = getattr(args, "sort", "chip") or "chip"
        self.filter = ""
        self.filter_mode = False
        self.show_help = False
        # the limit scale by default: the chart should show the distance to the
        # limit, not the shape of the noise. `a` switches to autoscaling.
        self.autoscale = False
        # the time window of the history panel (an index into WINDOWS) and the
        # right-panel toggle: one sensor's history, or a dual-axis view of the chip
        self.window = int(clamp(getattr(args, "window", 0) or 0, 0, len(WINDOWS) - 1))
        self.dual = bool(getattr(args, "dual", False))
        # buckets are computed once per sample, not once per frame (the loop draws ~30x/s)
        self._buckets: dict[tuple, list] = {}
        self.ascii = getattr(args, "ascii", False)
        self.braille = not self.ascii  # verified once curses has started
        self.paused = False
        self.last_read = 0.0
        self.samples = 0
        self.host = socket.gethostname()
        self.err: Optional[str] = None
        self.namer = ChipNamer(self.cfg.aliases)
        self.prio = PriorityMap(self.cfg.priorities)
        self.refs = SysfsRefs(getattr(args, "hwmon_root", "/sys/class/hwmon"))
        self.show_dead = getattr(args, "show_dead", False)
        self.dead_after = getattr(args, "dead_after", 20)
        self.hide_stale = getattr(args, "hide_stale", False)
        # the lower bound can be dynamic: (None, 130.0) => compute it from the readings
        self.temp_range = getattr(args, "temp_range", (None, TEMP_PHYSICAL[1]))
        self.floor_margin = getattr(args, "floor_margin", TEMP_FLOOR_MARGIN)
        self.floor = self.temp_range[0]
        self.hide_dupes = getattr(args, "hide_duplicates", False)
        self.dupes: dict[str, str] = {}  # duplicate key -> canonical key
        self.hide_pats: list[str] = list(self.cfg.hidden)  # hidden manually
        self.sel_key: Optional[str] = None  # what the user picked; `sel` is only its row
        self.hidden_rows: list[tuple[Reading, str]] = []  # (sensor, reason)
        self.hidden = 0
        self.show_hidden = False
        self.status: Optional[str] = None  # the footer message
        self.status_until = 0.0
        if self.cfg.error:
            self.status, self.status_until = f"config: {self.cfg.error}", time.time() + 8

    # -- data ---------------------------------------------------------------

    def poll(self) -> None:
        try:
            data = self.src.read()
        except Exception as exc:  # noqa: BLE001
            self.err = f"read error: {exc}"
            return
        if not data:
            self.err = "no readings from `sensors` (check `sensors-detect`)"
            return
        self.err = None
        self.ingest(data)

    def ingest(self, data: list[Reading]) -> None:
        """Takes in a sample: history, aliases, the lower floor, duplicates."""
        if self.temps_only:
            data = [r for r in data if r.kind == "temp"]
        self.readings = data
        for r in data:
            st = self.stats.setdefault(r.key, Stats())
            if r.valid:  # NaN must not reach min/max/mean
                st.push(r.value)
        self.namer.rebuild([r.chip for r in data])
        self.floor = (
            dynamic_floor(data, self.floor_margin)
            if self.temp_range[0] is None
            else self.temp_range[0]
        )
        self.find_duplicates()
        self._buckets.clear()  # the history changed - the aggregates need recomputing
        self.samples += 1
        self.last_read = time.time()

    def range_now(self) -> tuple[float, float]:
        """The range considered physically possible for this sample."""
        return (self.floor if self.floor is not None else TEMP_PHYSICAL[0], self.temp_range[1])

    def dead(self, r: Reading) -> Optional[str]:
        pat = self.hidden_by_user(r)
        if pat:
            return f"hidden manually ({pat})"
        return dead_reason(
            r,
            self.stats.setdefault(r.key, Stats()),
            self.dead_after,
            self.range_now(),
            self.hide_stale,
        )

    def hidden_by_user(self, r: Reading) -> Optional[str]:
        """The [hidden] pattern matching the sensor, or None."""
        name = sensor_id(r)
        return next((p for p in self.hide_pats if fnmatch.fnmatch(name, p)), None)

    def toggle_hidden(self, r: Reading) -> str:
        """Hides/unhides a sensor. Returns the footer message."""
        name = sensor_id(r)
        matching = [p for p in self.hide_pats if fnmatch.fnmatch(name, p)]
        exact = glob.escape(name)  # a name with `[` must match itself as a pattern
        if matching:
            self.hide_pats = [p for p in self.hide_pats if p not in matching]
            extra = " (pattern)" if matching != [exact] else ""
            return f"unhid {self.namer.qualified(r)}{extra} - `W` saves"
        self.hide_pats.append(exact)
        return f"hid {self.namer.qualified(r)} - `W` saves"

    def save_config(self) -> str:
        """Dumps the current UI state into config.toml. Returns the footer message."""
        cfg = self.cfg
        lo, hi = self.temp_range
        sel = self.selected()
        cfg.ui.update(
            {
                "sort": self.sort,
                "interval": float(self.interval),
                "fahrenheit": self.fahrenheit,
                "temps_only": self.temps_only,
                "hide_duplicates": self.hide_dupes,
                "show_dead": self.show_dead,
                "hide_stale": self.hide_stale,
                "mono": self.mono,
                "ascii": self.ascii,
                "window": int(self.window),
                "dual": self.dual,
                # an empty sensor list is not a user decision - in that case we
                # keep writing whatever was already in the file
                "selected": sensor_id(sel) if sel is not None else self.want_sel,
            }
        )
        cfg.temps.update(
            {
                "range": f"{'auto' if lo is None else f'{lo:g}'}:{hi:g}",
                "floor_margin": float(self.floor_margin),
                "dead_after": int(self.dead_after),
            }
        )
        cfg.hidden = list(self.hide_pats)
        if not cfg.priorities:
            # the first save: the map should be visible and editable in the file
            # rather than buried in the code - that is what [priorities] is for
            cfg.priorities = list(DEFAULT_PRIORITIES)
        if not cfg.aliases:
            # the first save: list the detected chips, so the file can be edited
            cfg.aliases = detected_aliases(self.namer, [r.chip for r in self.readings])
        try:
            cfg.save()
        except OSError as exc:
            return f"could not save {cfg.path}: {exc.strerror or exc}"
        return f"saved {cfg.path}"

    def find_duplicates(self) -> None:
        """Detects the same measurement read two ways (k10temp Tctl vs nct6799 TSI0).

        The criterion is purely quantitative (see `mirrors`): agreement of the
        readings over time, regardless of adapter and label. The reading with
        the hwmon limit stays canonical, the other one gets the ≡ marker.

        The only restriction beyond `mirrors`: pairs from the same chip are
        skipped. Two cores of the same CPU are entitled to identical
        temperatures and are still two sensors.
        """
        temps = [r for r in self.readings if r.kind == "temp" and r.valid]
        dupes: dict[str, str] = {}
        for i, a in enumerate(temps):
            for b in temps[i + 1 :]:
                if a.chip == b.chip or b.key in dupes or a.key in dupes:
                    continue
                if mirrors(self.stats[a.key].hist, self.stats[b.key].hist):
                    first, second = sorted((a, b), key=self._dupe_rank)
                    dupes[second.key] = first.key
        self.dupes = dupes

    @staticmethod
    def _dupe_rank(r: Reading) -> tuple:
        # the canonical one is the one with the hwmon limit (i.e. the "proper" driver)
        has_limit = r.high is not None or r.crit is not None
        return (0 if has_limit else 1, r.chip, r.label)

    def dupe_of(self, r: Reading) -> Optional[Reading]:
        canon = self.dupes.get(r.key)
        if not canon:
            return None
        return next((x for x in self.readings if x.key == canon), None)

    def build_rows(self) -> None:
        flt = self.filter.lower()
        alive: list[Reading] = []
        hidden: list[tuple[Reading, str]] = []
        for r in self.readings:
            why = self.dead(r)
            if why is None and self.hide_dupes and r.key in self.dupes:
                canon = self.dupe_of(r)
                why = f"duplicate of {self.namer.qualified(canon)}" if canon else "duplicate"
            if why is None or self.show_dead:
                alive.append(r)
            if why is not None:
                hidden.append((r, why))
        self.hidden_rows = hidden
        self.hidden = len(hidden)
        items = [
            r
            for r in alive
            if not flt
            or flt in r.label.lower()
            or flt in r.chip.lower()
            or flt in self.namer.alias(r.chip).lower()
        ]
        rows: list[tuple] = []
        if self.sort == "chip":
            chips: dict[str, list[Reading]] = {}
            for r in items:
                chips.setdefault(r.chip, []).append(r)
            for chip, lst in chips.items():
                lst.sort(key=lambda r: (KIND_ORDER.get(r.kind, 9), r.label))
                rows.append(("chip", chip))
                rows.extend(("sensor", r) for r in lst)
        else:
            if self.sort == "value":
                # descending by reading, within the sensor kind
                items = sorted(
                    items, key=lambda r: (KIND_ORDER.get(r.kind, 9), -r.value)
                )
            else:
                items = sorted(items, key=lambda r: (r.label.lower(), r.chip))
            rows.extend(("sensor", r) for r in items)
        self.rows = rows
        self.apply_selection()

    def apply_selection(self) -> None:
        """Keeps the selection inside the list, and sets it itself at startup.

        The first sensor of the list is an accident - that is how the adapter
        order falls out in hwmon, not a hierarchy of importance. So on the
        first non-empty set we take the sensor saved in [ui], and when it is
        missing (or gone from the hardware), the top of the [priorities] ranking.
        """
        n = self.sensor_count()
        if not n:
            self.sel = 0
            return  # an empty list is not a choice - the restore is still ahead
        if not self.sel_restored:
            self.sel = self.initial_index()
            self.sel_restored = True
            self.remember_selection()
        else:
            # follow the sensor across re-sorts; while it is filtered out or gone,
            # keep the row and the key, so it is picked up again when it returns
            visible = (v for k, v in self.rows if k == "sensor")
            row = next((i for i, r in enumerate(visible) if r.key == self.sel_key), None)
            if row is not None:
                self.sel = row
        self.sel = int(clamp(self.sel, 0, n - 1))

    def remember_selection(self) -> None:
        r = self.selected()
        self.sel_key = r.key if r is not None else None

    def initial_index(self) -> int:
        """The index of the sensor that should be selected at startup."""
        visible = [v for k, v in self.rows if k == "sensor"]
        if self.want_sel:
            for i, r in enumerate(visible):
                if sensor_id(r) == self.want_sel:
                    return i
        return min(range(len(visible)), key=lambda i: self.rank(visible[i]))

    def rank(self, r: Reading) -> tuple:
        """The sensor's place in the role ranking (see [priorities] and `rank_key`)."""
        st = self.stats.get(r.key) or Stats()
        return rank_key(r, self.prio.klass(r), ratio_of(r, st, self.refs))

    def sensor_count(self) -> int:
        return sum(1 for k, _ in self.rows if k == "sensor")

    def selected(self) -> Optional[Reading]:
        i = 0
        for kind, val in self.rows:
            if kind == "sensor":
                if i == self.sel:
                    return val
                i += 1
        return None

    # -- formatting ---------------------------------------------------------

    def fmt(self, r: Reading, value: Optional[float] = None) -> str:
        v = r.value if value is None else value
        if math.isnan(v):
            return "      —"
        if r.kind == "temp":
            if self.fahrenheit:
                return f"{to_f(v):5.1f}°F"
            return f"{v:5.1f}°C"
        if r.kind == "fan":
            return f"{v:5.0f} RPM"
        if r.kind == "freq":
            return fmt_freq(v)
        if r.kind == "in":
            return f"{v:6.3f} V"
        if r.kind == "power":
            return f"{v:5.1f} W"
        if r.kind == "curr":
            return f"{v:5.2f} A"
        return f"{v:6.1f}{r.unit}"

    # -- the main loop ------------------------------------------------------

    def run(self, stdscr) -> None:
        curses.curs_set(0)
        stdscr.nodelay(True)
        stdscr.keypad(True)
        self.theme = Theme(init_colors(self.mono))
        # --ascii forces the fallback; otherwise we check whether the terminal
        # can handle braille - a POSIX/latin1 locale would print garbage instead
        self.braille = not self.ascii and braille_supported(stdscr)
        if not self.braille and not self.ascii:
            self.set_status("terminal without braille support - ASCII charts", 6.0)
        self.poll()
        next_read = time.time() + self.interval
        while True:
            now = time.time()
            if not self.paused and now >= next_read:
                self.poll()
                next_read = now + self.interval
            self.build_rows()
            self.draw(stdscr)
            ch = stdscr.getch()
            if ch != -1 and not self.handle_key(ch, stdscr):
                return
            if ch == -1:
                time.sleep(0.03)

    def handle_key(self, ch: int, stdscr) -> bool:
        """Returns False when the program should quit."""
        if self.filter_mode:
            if ch in (27, curses.KEY_EXIT):
                self.filter, self.filter_mode = "", False
            elif ch in (10, 13, curses.KEY_ENTER):
                self.filter_mode = False
            elif ch in (curses.KEY_BACKSPACE, 127, 8):
                self.filter = self.filter[:-1]
            elif 32 <= ch < 127:
                self.filter += chr(ch)
            return True

        if (self.show_help or self.show_hidden) and ch != curses.KEY_RESIZE:
            self.show_help = self.show_hidden = False
            return True

        n = max(self.sensor_count(), 1)
        sel_before = self.sel
        if ch in (ord("q"), ord("Q"), 27):
            return False
        elif ch in (curses.KEY_DOWN, ord("j")):
            self.sel = (self.sel + 1) % n
        elif ch in (curses.KEY_UP, ord("k")):
            self.sel = (self.sel - 1) % n
        elif ch == curses.KEY_NPAGE:
            self.sel = int(clamp(self.sel + 10, 0, n - 1))
        elif ch == curses.KEY_PPAGE:
            self.sel = int(clamp(self.sel - 10, 0, n - 1))
        elif ch == curses.KEY_HOME:
            self.sel = 0
        elif ch == curses.KEY_END:
            self.sel = n - 1
        elif ch in (ord("s"), ord("S")):
            self.sort = SORTS[(SORTS.index(self.sort) + 1) % len(SORTS)]
        elif ch == ord("/"):
            self.filter_mode = True
        elif ch in (ord("c"), ord("C")):
            self.fahrenheit = not self.fahrenheit
        elif ch in (ord("a"), ord("A")):
            self.autoscale = not self.autoscale
        elif ch in (ord("t"), ord("T")):
            self.temps_only = not self.temps_only
            if self.paused:  # a poll would record a sample during the pause
                self.set_status("applies after resuming", 3.0)
            else:
                self.poll()
        elif ch in (ord("z"), ord("Z")):
            self.show_dead = not self.show_dead
        elif ch in (ord("h"), ord("H")):
            self.show_hidden = True
        elif ch in (ord("d"), ord("D")):
            self.hide_dupes = not self.hide_dupes
        elif ch in (ord("x"), ord("X")):
            r = self.selected()
            if r is not None:
                self.set_status(self.toggle_hidden(r))
        elif ch == ord("w"):
            self.window = (self.window + 1) % len(WINDOWS)
            self.set_status(f"window {self.window_label()}", 2.5)
        elif ch == ord("W"):
            self.set_status(self.save_config(), 6.0)
        elif ch in (ord("u"), ord("U")):
            self.dual = not self.dual
            if stdscr is not None and stdscr.getmaxyx()[1] < 84:
                # the right column is not drawn at all then - without this
                # message the key looks broken
                self.set_status("the chip panel needs >= 84 columns", 4.0)
        elif ch in (ord("+"), ord("=")):
            self.interval = round(min(self.interval + 0.5, 60.0), 1)
        elif ch == ord("-"):
            self.interval = round(max(self.interval - 0.5, 0.5), 1)
        elif ch in (ord("r"), ord("R")):
            for st in self.stats.values():
                st.reset()
                st.hist.clear()
            self._buckets.clear()
            self.samples = 0
        elif ch == ord(" "):
            self.paused = not self.paused
        elif ch in (ord("?"), curses.KEY_F1):
            self.show_help = True
        elif ch == curses.KEY_RESIZE:
            stdscr.clear()
        if self.sel != sel_before:
            self.remember_selection()
        return True

    def set_status(self, msg: str, secs: float = 4.0) -> None:
        self.status, self.status_until = msg, time.time() + secs

    # -- chart renderers (braille or ASCII) ---------------------------------

    def area(self, series, width: int, height: int, lo: float, hi: float) -> list[str]:
        if self.braille:
            return braille_area(series, width, height, lo, hi)
        return ascii_area(series, width, height, lo, hi)

    def spark(self, series, width: int) -> str:
        return braille_line(series, width) if self.braille else ascii_line(series, width)

    def band(self, cols, width, height, lo, hi, repeat=1, fill=True, down=False):
        return band_area(
            cols, width, height, lo, hi, repeat,
            braille=self.braille, band=fill, down=down,
        )

    # -- time windows -------------------------------------------------------

    @property
    def bucket(self) -> int:
        """How many samples go into one bucket in the current window (1 = raw)."""
        return WINDOWS[self.window]

    def window_label(self) -> str:
        """The window resolution computed from the interval - not a hardcoded '30 s'.

        At `-i 1` a 15-sample bucket is 15 seconds and should be labelled as
        such; the label has to say what is actually on screen.
        """
        return fmt_span(self.bucket * self.interval)

    def buckets(self, key: str, bucket: int) -> list:
        """A sensor's buckets for the given window - computed once per sample, not per frame."""
        ck = (key, bucket)
        got = self._buckets.get(ck)
        if got is None:
            st = self.stats.get(key)
            got = aggregate(st.hist, bucket) if st is not None else []
            self._buckets[ck] = got
        return got

    @staticmethod
    def bucket_width(bucket: int, slots: int) -> int:
        """The bucket width in slots, so a full buffer fills the panel.

        At 1 slot each, six five-minute buckets would take three cells at the
        right edge and leave the rest of the panel empty - so we stretch them
        instead of pretending there is less data.
        """
        return max(1, slots // max(1, HISTORY_CAP // bucket))

    def slots_of(self, width: int) -> int:
        """How many samples/buckets fit horizontally: braille has 2 per cell."""
        return width * (2 if self.braille else 1)

    # -- views --------------------------------------------------------------

    def draw(self, stdscr) -> None:
        stdscr.erase()
        h, w = stdscr.getmaxyx()
        if h < 8 or w < 40:
            safe_addstr(stdscr, 0, 0, "Terminal too small (min. 40x8)", self.theme.c(P_WARN))
            stdscr.refresh()
            return

        self.draw_header(stdscr, w)

        body_y, body_h = 1, h - 2
        wide = w >= 84
        left_w = int(w * 0.58) if wide else w
        self.draw_list(stdscr, body_y, 0, body_h, left_w)
        if wide:
            right_x = left_w
            right_w = w - left_w
            graph_h = max(7, int(body_h * 0.55))
            info_h = body_h - graph_h
            if info_h < 6:
                graph_h, info_h = body_h - 6, 6
            self.draw_graph(stdscr, body_y, right_x, graph_h, right_w)
            self.draw_info(stdscr, body_y + graph_h, right_x, info_h, right_w)

        self.draw_footer(stdscr, h - 1, w)
        if self.show_help:
            self.draw_help(stdscr, h, w)
        elif self.show_hidden:
            self.draw_hidden(stdscr, h, w)
        stdscr.refresh()

    def draw_hidden(self, win, h, w) -> None:
        """The list of rejected sensors with the reason - so hiding stays checkable."""
        th = self.theme
        rows = self.hidden_rows
        bw = min(w - 4, 76)
        max_rows = max(3, min(len(rows), h - 6))
        bh = max_rows + 4
        by = max(0, (h - bh) // 2)
        bx = max(0, (w - bw) // 2)
        for i in range(bh):
            safe_addstr(win, by + i, bx, " " * bw, th.c(P_TEXT))
        lo, hi = self.range_now()
        auto = " auto" if self.temp_range[0] is None else ""
        title = f"hidden sensors ({len(rows)}) · floor{auto} {lo:g}-{hi:g} °C"
        draw_box(win, by, bx, bh, bw, title, th)

        if not rows:
            safe_addstr(win, by + 1, bx + 2, "nothing is hidden", th.c(P_DIM))
        name_w = 26
        val_w = 10
        for i, (r, why) in enumerate(rows[:max_rows]):
            yy = by + 1 + i
            safe_addstr(
                win, yy, bx + 2, ellipsis(self.namer.qualified(r), name_w), th.c(P_TEXT)
            )
            safe_addstr(
                win, yy, bx + 2 + name_w, self.fmt(r).rjust(val_w), th.c(P_DIM)
            )
            safe_addstr(
                win,
                yy,
                bx + 3 + name_w + val_w,
                ellipsis(why, bw - name_w - val_w - 6),
                th.c(P_WARN),
            )
        if len(rows) > max_rows:
            safe_addstr(
                win,
                by + bh - 3,
                bx + 2,
                f"…and {len(rows) - max_rows} more (press z to show them all)",
                th.c(P_DIM),
            )
        safe_addstr(win, by + bh - 2, bx + 2, "any key - back", th.c(P_DIM))

    def header_temps(self) -> list[Reading]:
        """The temperatures behind the header's max/avg - never an unreadable one."""
        return [
            r
            for r in self.readings
            if r.kind == "temp" and r.valid and (self.show_dead or not self.dead(r))
        ]

    def draw_header(self, win, w: int) -> None:
        th = self.theme
        title = f" sensortop {VERSION} "
        safe_addstr(win, 0, 1, title, th.c(P_TITLE) | curses.A_BOLD)
        x = 1 + len(title) + 1
        safe_addstr(win, 0, x, self.host, th.c(P_HDR) | curses.A_BOLD)
        x += len(self.host) + 2

        temps = self.header_temps()
        if temps:
            # hottest = the highest reading, not "closest to its limit" -
            # otherwise a sensor with a low limit beats a genuinely warmer one
            hottest = max(temps, key=lambda r: r.value)
            avg = sum(r.value for r in temps) / len(temps)
            st = self.stats.get(hottest.key, Stats())
            info = f"max {self.namer.qualified(hottest)} {self.fmt(hottest)}"
            ratio = ratio_of(hottest, st, self.refs) or 0.0
            safe_addstr(win, 0, x, info, th.grad(ratio) | curses.A_BOLD)
            x += len(info) + 2
            a = Reading("", "", "", "temp", avg)
            txt = f"avg {self.fmt(a, avg)}"
            safe_addstr(win, 0, x, txt, th.c(P_DIM))
            x += len(txt) + 2

        right = time.strftime("%H:%M:%S")
        load = self.loadavg()
        if load:
            right = f"load {load}  {right}"
        if self.paused:
            right = "[PAUSED]  " + right
        safe_addstr(win, 0, max(x, w - len(right) - 1), right, th.c(P_DIM))

    @staticmethod
    def loadavg() -> str:
        try:
            with open("/proc/loadavg", encoding="ascii") as fh:
                p = fh.read().split()
            return f"{p[0]} {p[1]} {p[2]}"
        except OSError:
            return ""

    def draw_list(self, win, y, x, h, w) -> None:
        th = self.theme
        title = f"sensors [{SORT_LABELS[self.sort]}]"
        if self.filter:
            title += f" /{self.filter}"
        if self.hidden:
            title += f" · {self.hidden} hidden"
        elif self.show_dead:
            title += " · incl. dead"
        draw_box(win, y, x, h, w, title, th)
        inner_h, inner_w = h - 2, w - 4
        if inner_h <= 0 or inner_w <= 10:
            return

        # scrolling: find the row index of the selected sensor
        sel_row, seen = 0, 0
        for i, (kind, _v) in enumerate(self.rows):
            if kind == "sensor":
                if seen == self.sel:
                    sel_row = i
                    break
                seen += 1
        if sel_row < self.offset:
            self.offset = sel_row
        elif sel_row >= self.offset + inner_h:
            self.offset = sel_row - inner_h + 1
        self.offset = int(clamp(self.offset, 0, max(0, len(self.rows) - inner_h)))

        # column widths
        val_w = 11
        spark_w = 10 if inner_w > 74 else 0
        lbl_w = max(10, min(20, inner_w - val_w - spark_w - 14))
        bar_w = inner_w - lbl_w - val_w - spark_w - 3

        idx = 0  # the sensor number (to compare against self.sel)
        cur = -1
        row_y = y + 1
        drawn = 0
        for i, (kind, val) in enumerate(self.rows):
            if kind == "sensor":
                cur = idx
                idx += 1
            if i < self.offset:
                continue
            if drawn >= inner_h:
                break
            yy = row_y + drawn
            drawn += 1
            if kind == "chip":
                alias = self.namer.alias(val)
                safe_addstr(win, yy, x + 2, "▎", th.c(P_HDR) | curses.A_BOLD)
                safe_addstr(
                    win, yy, x + 3, ellipsis(alias, inner_w - 2), th.c(P_HDR) | curses.A_BOLD
                )
                sx = x + 3 + len(alias) + 1
                safe_addstr(win, yy, sx, ellipsis(val, x + w - 12 - sx), th.c(P_FRAME))
                cnt = sum(1 for k, v in self.rows if k == "sensor" and v.chip == val)
                tag = f"{cnt} sens."
                safe_addstr(win, yy, x + w - 2 - len(tag), tag, th.c(P_FRAME))
                continue

            r: Reading = val
            st = self.stats.setdefault(r.key, Stats())
            ratio = ratio_of(r, st, self.refs)
            alarm = alarm_level(r)
            pal = palette_of(r)
            sel = cur == self.sel
            is_dead = self.dead(r) is not None

            # with a sort other than by chip the label alone can mislead
            # ("mem" - RAM or GPU memory?), so we add the chip alias
            name = r.label if self.sort == "chip" else self.namer.qualified(r)
            if r.key in self.dupes:
                name = "≡" + name  # the same measurement as another sensor
            marker = "▶" if sel else " "
            name_attr = th.c(P_SEL) | curses.A_BOLD if sel else th.c(P_TEXT)
            if is_dead:
                name_attr = th.c(P_FRAME)
            safe_addstr(win, yy, x + 1, marker, th.c(P_SEL) | curses.A_BOLD)
            safe_addstr(win, yy, x + 2, ellipsis(name, lbl_w).ljust(lbl_w), name_attr)

            bx = x + 2 + lbl_w + 1
            if bar_w > 3:
                if is_dead or ratio is None:
                    # no reference = no bar; an empty space beats a fill that
                    # pretends to be information
                    safe_addstr(win, yy, bx, "·" * bar_w, th.c(P_FRAME))
                else:
                    draw_bar(win, yy, bx, bar_w, ratio, th, palette=pal)

            # the gradient stays on the bar; the value text keeps a fixed, readable colour
            if is_dead:
                vattr = th.c(P_FRAME)
            elif alarm == 2:
                vattr = th.c(P_CRIT) | curses.A_BOLD | curses.A_REVERSE
            elif alarm == 1:
                vattr = th.c(P_WARN) | curses.A_BOLD
            elif r.kind == "temp":
                vattr = th.grad(ratio or 0.0, pal) | curses.A_BOLD
            else:
                vattr = th.c(P_VALUE) | curses.A_BOLD
            safe_addstr(win, yy, bx + bar_w + 1, self.fmt(r).rjust(val_w), vattr)

            if spark_w:
                sx = bx + bar_w + 1 + val_w + 1
                spark = "" if is_dead else self.spark(st.hist, spark_w)
                sattr = (
                    th.grad(ratio or 0.0, pal)
                    if r.kind == "temp"
                    else th.c(P_ACCENT)
                )
                safe_addstr(win, yy, sx, spark, sattr)

        if len(self.rows) > inner_h:
            info = f"{self.offset + 1}-{min(self.offset + inner_h, len(self.rows))}/{len(self.rows)}"
            safe_addstr(win, y + h - 1, x + w - len(info) - 3, f" {info} ", th.c(P_FRAME))

    def draw_graph(self, win, y, x, h, w) -> None:
        if self.dual:
            self.draw_dual(win, y, x, h, w)
            return
        th = self.theme
        r = self.selected()
        span = self.window_label()
        if r is None:
            draw_box(win, y, x, h, w, f"history {span}", th)
            safe_addstr(win, y + 1, x + 2, "no sensors", th.c(P_DIM))
            return
        st = self.stats.setdefault(r.key, Stats())
        draw_box(win, y, x, h, w, f"history {span} - {self.namer.qualified(r)}", th)

        gh, gw = h - 2, w - 9
        if gh <= 0 or gw <= 4:
            return
        data = list(st.hist)
        if not data:
            safe_addstr(win, y + 1, x + 2, "collecting data…", th.c(P_DIM))
            return

        lo, hi, scale_name = self.graph_scale(r, st, data)

        pal = palette_of(r)
        thr = graph_threshold(r)
        # the limit row is computed before drawing, so the line lands in the
        # same grid as the chart (and not next to it)
        thr_row = row_at(thr[0], lo, hi, gh) if thr else None
        bucket, slots = self.bucket, self.slots_of(gw)
        if bucket == 1:
            # the raw window stays an area chart: with one sample per slot the
            # min-max band would be a line of zero height
            rows = self.area(data, gw, gh, lo, hi)
            marks: list[list[int]] = [[]] * gh
            shown = min(len(data), slots)
        else:
            cols = self.buckets(r.key, bucket)
            step = self.bucket_width(bucket, slots)
            rows, marks = self.band(cols, gw, gh, lo, hi, step)
            shown = min(len(cols), max(1, slots // step))
        mean_attr = th.c(P_ACCENT) | curses.A_BOLD
        blank, rule = ("⠀", "─") if self.braille else (" ", "-")
        for i, line in enumerate(rows):
            # vertical gradient: the top of the chart = a higher value = a warmer colour
            t = 1.0 - (i / max(gh - 1, 1))
            if r.kind == "temp":
                attr = th.grad(t * ratio_scale(r, hi), pal)
            else:
                # the cool palette only in its bright half - the bottom of the
                # chart has to stay readable on a black background too
                attr = th.grad(0.45 + 0.55 * t, pal)
            if i == thr_row:
                # the limit line only where there is no data: the chart fill is
                # meant to cover it, because exceeding the limit is exactly what
                # you see when the fill reaches above the line
                for col, ch in enumerate(line):
                    if ch == blank:
                        safe_addstr(win, y + 1 + i, x + 2 + col, rule, th.c(P_WARN))
                    else:
                        safe_addstr(win, y + 1 + i, x + 2 + col, ch, attr)
            else:
                safe_addstr(win, y + 1 + i, x + 2, line, attr)
            # the mean goes on top of the band: the same character, a different
            # colour - otherwise an aggregated window shows only the spread
            for col in marks[i]:
                safe_addstr(win, y + 1 + i, x + 2 + col, line[col], mean_attr)

        # the Y axis
        for i in range(gh):
            frac = 1.0 - (i / max(gh - 1, 1))
            v = lo + (hi - lo) * frac
            if i == thr_row:
                lab = self.axis_label(r, thr[0])
                safe_addstr(win, y + 1 + i, x + w - 8, lab.rjust(7), th.c(P_WARN) | curses.A_BOLD)
            elif i == 0 or i == gh - 1 or (gh > 4 and i == gh // 2):
                lab = self.axis_label(r, v)
                safe_addstr(win, y + 1 + i, x + w - 8, lab.rjust(7), th.c(P_DIM))

        # the caption talks about what is on screen, not about what is in the
        # buffer: with a 30 s window "60x30 s = 30 min" is not "900 samples"
        if bucket == 1:
            covered, label = shown, f"{self.interval:g}s"
        else:
            # the leftmost bucket can be incomplete, so "shown x bucket" may
            # promise more history than exists - count the real samples instead
            covered = len(data) if shown >= len(cols) else shown * bucket
            label = fmt_span(bucket * self.interval)
        note = f"{shown}×{label} = {fmt_span(covered * self.interval)} · {scale_name}"
        safe_addstr(win, y + h - 1, x + 2, f" {note} "[: w - 4], th.c(P_FRAME))

    def graph_scale(self, r: Reading, st: Stats, data: list) -> tuple[float, float, str]:
        """The vertical range of the chart and a description of its source."""
        fixed = graph_range(r, st, self.refs)
        if not self.autoscale and fixed is not None:
            lo, hi, src = fixed
            # a reading above the limit must not be clipped to the ceiling -
            # otherwise overheating looks just like hitting the limit exactly
            top = max(data)
            if top > hi:
                hi = top * 1.02
            return lo, hi, f"{src} {self.fmt(r, fixed[1]).strip()}"
        lo, hi = min(data), max(data)
        pad = max((hi - lo) * 0.15, abs(hi) * 0.02 + 0.5)
        if fixed is None and not self.autoscale:
            why = "no limit" if r.kind == "temp" else "no reference"
            return lo - pad, hi + pad, f"auto ({why})"
        return lo - pad, hi + pad, "auto"

    def axis_label(self, r: Reading, v: float) -> str:
        if r.kind == "temp":
            return f"{to_f(v):.0f}F" if self.fahrenheit else f"{v:.0f}°"
        if r.kind == "fan":
            return f"{v:.0f}"
        if r.kind == "freq":
            return fmt_freq(v).replace(" ", "").rstrip("z").rstrip("H")
        if r.kind == "in":
            return f"{v:.2f}V"
        return f"{v:.1f}"

    # -- the dual-axis panel ------------------------------------------------

    def dual_series(self, chip: str) -> tuple[list, list, int]:
        """The chip's temperatures and fans + how many series did not fit.

        The source is `self.rows`, so the panel respects the filter, the hidden
        list and dedupe: a sensor hidden from the list has no business coming
        back through a side door. The order is the same role ranking that picks
        the sensor at startup - so the least relevant series drop out of the
        panel, not simply the ones hwmon listed last.
        """
        shown = [v for k, v in self.rows if k == "sensor" and v.chip == chip and v.valid]
        temps = sorted((s for s in shown if s.kind == "temp"), key=self.rank)
        fans = sorted((s for s in shown if s.kind == "fan"), key=self.rank)
        cut = max(0, len(temps) - DUAL_MAX) + max(0, len(fans) - DUAL_MAX)
        return temps[:DUAL_MAX], fans[:DUAL_MAX], cut

    def dual_top(self, series: list, temp: bool) -> float:
        """The upper bound of one half of the panel: the highest reference in the group.

        All series in one half share a scale - otherwise two charts side by
        side would mean different things and comparing 'which fan spins faster'
        would be an illusion.
        """
        top = 0.0
        for s in series:
            ref = temp_top(s)[0] if temp else (reference_top(s, self.refs) or (0.0,))[0]
            top = max(top, ref or 0.0)
            st = self.stats.get(s.key)
            if st is not None and st.count:
                top = max(top, st.vmax * 1.02)  # a reading above the limit must not be clipped
        if top <= 0:
            top = TEMP_SCALE_FALLBACK if temp else DEFAULT_FAN_TOP
        return max(top, TEMP_SCALE_FLOOR + 20.0) if temp else top

    def draw_dual(self, win, y, x, h, w) -> None:
        """Two axes of one chip: temperatures upwards, fan speeds downwards.

        The centre axis is the zero of both halves, not a shared point - °C and
        RPM have no common unit, so each half has its own scale, described at
        the right edge and in the panel footer.
        """
        th = self.theme
        r = self.selected()
        span = self.window_label()
        if r is None:
            draw_box(win, y, x, h, w, f"chip {span}", th)
            safe_addstr(win, y + 1, x + 2, "no sensors", th.c(P_DIM))
            return
        chip = r.chip
        draw_box(win, y, x, h, w, f"chip {span} - {self.namer.alias(chip)}", th)
        gw = w - 9
        inner = h - 2
        if gw < 6 or inner < 4:
            if inner >= 1:  # with two rows there is nowhere to write this
                safe_addstr(win, y + 1, x + 2, "the panel needs a larger window", th.c(P_DIM))
            return

        temps, fans, cut = self.dual_series(chip)
        if not temps and not fans:
            safe_addstr(
                win, y + 1, x + 2, "the chip has no temperatures or fans", th.c(P_DIM)
            )
            return

        # height split: the axis and the legend take one row each, the rest is halved
        avail = inner - 2
        if not fans:
            t_h, f_h = avail, 0
        elif not temps:
            t_h, f_h = 0, avail
        else:
            t_h = max(1, (avail + 1) // 2)
            f_h = avail - t_h
        axis_y = y + 1 + t_h
        legend_y = y + h - 2
        bucket, slots = self.bucket, self.slots_of(gw)
        step = 1 if bucket == 1 else self.bucket_width(bucket, slots)

        t_lo, t_hi = TEMP_SCALE_FLOOR, self.dual_top(temps, True)
        f_hi = self.dual_top(fans, False)

        def paint(series, top_y, height, lo, hi, down, attrs) -> None:
            if height <= 0 or not series:
                return
            layers = []
            for i, s in enumerate(series):
                # the min-max band only for the selected sensor - several bands
                # at once merge into a blob in which no series is visible
                fill = bucket > 1 and s.key == r.key
                grid, _mean = cell_grid(
                    self.buckets(s.key, bucket), gw, height, lo, hi, step,
                    band=fill, braille=self.braille, down=down,
                )
                layers.append((i, grid))
            grid, owner = merge_layers(layers, gw, height)
            for ry in range(height):
                row, own = grid[ry], owner[ry]
                col = 0
                while col < gw:
                    if not row[col]:
                        col += 1
                        continue
                    who, start, chunk = own[col], col, []
                    while col < gw and row[col] and own[col] == who:
                        chunk.append(chr(0x2800 + row[col]) if self.braille else ASCII_FILL)
                        col += 1
                    safe_addstr(win, top_y + ry, x + 2 + start, "".join(chunk), attrs[who])

        def temp_attr(s: Reading) -> int:
            st = self.stats.setdefault(s.key, Stats())
            attr = th.grad(ratio_of(s, st, self.refs) or 0.0, "heat")
            return attr | curses.A_BOLD if s.key == r.key else attr

        def fan_attr(i: int) -> int:
            attr = th.grad(0.45 + 0.55 * (i / max(len(fans) - 1, 1)), "cool")
            return attr | curses.A_BOLD if fans[i].key == r.key else attr

        t_attrs = [temp_attr(s) for s in temps]
        f_attrs = [fan_attr(i) for i in range(len(fans))]
        paint(temps, y + 1, t_h, t_lo, t_hi, False, t_attrs)
        paint(fans, axis_y + 1, f_h, 0.0, f_hi, True, f_attrs)

        # the centre axis: the zero of both scales
        safe_addstr(win, axis_y, x + 2, "─" * gw, th.c(P_FRAME))
        if temps:
            safe_addstr(
                win, y + 1, x + w - 8, self.axis_label(temps[0], t_hi).rjust(7), th.c(P_DIM)
            )
        if fans and f_h:
            safe_addstr(
                win, axis_y + f_h, x + w - 8,
                self.axis_label(fans[0], f_hi).rjust(7), th.c(P_DIM),
            )
        zero = "/".join(
            ([self.axis_label(temps[0], t_lo)] if temps else []) + (["0"] if fans else [])
        )
        safe_addstr(win, axis_y, x + w - 8, zero.rjust(7), th.c(P_FRAME))

        # the legend - without it the series colour means nothing. Fans start
        # from the right edge: with four temperatures they would be the first to
        # fall off the row, and they are what explains the lower half of the panel.
        rx = x + w - 2
        right = []
        for s, attr in reversed(list(zip(fans, f_attrs))):
            txt = f"{s.label} {self.fmt(s).strip()}"
            if rx - len(txt) < x + 6:
                break
            rx -= len(txt)
            right.append((rx, txt, attr))
            rx -= 2
        for px, txt, attr in right:
            safe_addstr(win, legend_y, px, txt, attr)
        cx = x + 2
        for s, attr in zip(temps, t_attrs):
            txt = f"{s.label} {self.fmt(s).strip()}"
            if cx + len(txt) > rx - 2:
                safe_addstr(win, legend_y, cx, "…", th.c(P_DIM))
                break
            safe_addstr(win, legend_y, cx, txt, attr)
            cx += len(txt) + 2

        note = " · ".join(
            (
                [f"temp {self.axis_label(temps[0], t_lo)}-{self.axis_label(temps[0], t_hi)} ▲"]
                if temps
                else []
            )
            + ([f"rpm 0-{f_hi:g} ▼"] if fans else [])
        )
        if cut:
            note += f" · +{cut} off panel"
        safe_addstr(win, y + h - 1, x + 2, f" {note} "[: w - 4], th.c(P_FRAME))

    def draw_info(self, win, y, x, h, w) -> None:
        th = self.theme
        draw_box(win, y, x, h, w, "details", th)
        r = self.selected()
        if r is None or h < 4:
            return
        st = self.stats.setdefault(r.key, Stats())
        yy = y + 1
        cx = x + 2
        iw = w - 4

        lw = 11 if iw >= 34 else 9

        def line(label: str, value: str, attr=None) -> None:
            nonlocal yy
            if yy >= y + h - 1:
                return
            safe_addstr(win, yy, cx, ellipsis(label, lw).ljust(lw), th.c(P_DIM))
            safe_addstr(win, yy, cx + lw, ellipsis(value, iw - lw), attr or th.c(P_TEXT))
            yy += 1

        def val(v: float) -> str:
            return self.fmt(r, v).strip()

        alarm = alarm_level(r)
        dead = self.dead(r)
        state = ["OK", "WARNING", "CRITICAL"][alarm]
        sattr = [th.c(P_GRAD), th.c(P_WARN) | curses.A_BOLD, th.c(P_CRIT) | curses.A_BOLD][
            alarm
        ]
        if dead:
            state, sattr = f"dead - {dead}", th.c(P_FRAME)
        canon = self.dupe_of(r)
        if canon is not None:
            # the same character as the list marker - it shows whose reading this is
            line("duplicate", f"≡ {self.namer.qualified(canon)}", th.c(P_ACCENT))
        line("chip", f"{self.namer.alias(r.chip)} · {r.chip}")
        if r.adapter and h >= 10:
            line("adapter", r.adapter)
        if r.kind == "temp":
            vattr = th.grad(ratio_of(r, st, self.refs) or 0.0, "heat") | curses.A_BOLD
        else:
            vattr = th.c(P_VALUE) | curses.A_BOLD
        line("now", val(r.value), vattr)
        if st.count:
            line("min/avg/max", f"{val(st.vmin)} / {val(st.avg)} / {val(st.vmax)}")
        # how much history is really in the buffer - the panel shows only a
        # slice, and min/avg/max is computed from the session start, not from
        # those 900 samples
        if h >= 11:
            n = len(st.hist)
            line("buffer", f"{n}/{st.hist.cap} samples · {fmt_span(n * self.interval)}")
        limits = []
        if r.high is not None:
            limits.append(f"high {val(r.high)}")
        if r.crit is not None:
            limits.append(f"crit {val(r.crit)}")
        if r.low is not None:
            limits.append(f"min {val(r.low)}")
        line("limits", ", ".join(limits) if limits else "-")
        # where the bar fill comes from - otherwise 4485 RPM "almost maxed out"
        # looks like an alarm, while it is only a position against max RPM
        rng = scale_range(r, st, self.refs)
        if rng is None:
            scale_txt = "no reference - no bar"
        elif r.kind == "temp":
            _top, src = temp_top(r)
            scale_txt = f"{val(rng[0])}-{val(rng[1])} ({src or 'no limit'})"
        else:
            src_ref = reference_top(r, self.refs)
            scale_txt = f"0-{val(rng[1])} ({src_ref[1]})" if src_ref else f"0-{val(rng[1])}"
        line("scale", scale_txt)
        # the bar and the chart use the same scale, so a separate row is added
        # only when the chart falls out of it: no limit, or autoscaling turned
        # on by hand
        g = graph_range(r, st, self.refs)
        if self.autoscale:
            line("chart", "auto (the a key)")
        elif g is None:
            why = "no limit" if r.kind == "temp" else "no reference"
            line("chart", f"auto - {why}", th.c(P_WARN))
        line("state", state, sattr)

        # the global summary
        if yy < y + h - 1:
            shown = [v for k, v in self.rows if k == "sensor"]
            temps = [x_ for x_ in shown if x_.kind == "temp"]
            fans = [x_ for x_ in shown if x_.kind == "fan"]
            warn = sum(1 for x_ in temps if alarm_level(x_) > 0)
            summary = f"{len(shown)} sens. · {len(temps)} temp · {len(fans)} fans"
            if self.hidden:
                summary += f" · {self.hidden} dead"
            safe_addstr(win, yy, cx, summary[:iw], th.c(P_FRAME))
            yy += 1
            if yy < y + h - 1 and warn:
                safe_addstr(
                    win,
                    yy,
                    cx,
                    f"⚠ {warn} sensor(s) above the limit"[:iw],
                    th.c(P_WARN) | curses.A_BOLD,
                )

    def draw_footer(self, win, y, w) -> None:
        th = self.theme
        if self.filter_mode:
            prompt = f" filter: {self.filter}▏(Enter = apply, Esc = clear)"
            safe_addstr(win, y, 0, prompt.ljust(w)[:w], th.c(P_SEL) | curses.A_BOLD)
            return
        if self.err:
            safe_addstr(win, y, 0, f" ⚠ {self.err}".ljust(w)[:w], th.c(P_CRIT))
            return
        if self.status and time.time() < self.status_until:
            safe_addstr(win, y, 0, f" {self.status}".ljust(w)[:w], th.c(P_SEL) | curses.A_BOLD)
            return
        keys = [
            ("↑↓", "select"),
            ("s", "sort"),
            ("/", "filter"),
            ("c", "°C/°F"),
            ("a", "scale"),
            ("t", "temps only" if not self.temps_only else "all"),
            ("z", "hide dead" if self.show_dead else f"dead ({self.hidden})"),
            ("h", "what is hidden"),
            ("x", "hide sensor"),
            ("d", "dedupe" if not self.hide_dupes else "show duplicates"),
            ("w", f"window {self.window_label()}"),
            ("u", "history" if self.dual else "chip panel"),
            ("W", "save config"),
            ("+/-", f"{self.interval:g}s"),
            ("r", "reset"),
            ("␣", "pause"),
            ("?", "help"),
            ("q", "quit"),
        ]
        x = 1
        for k, desc in keys:
            if x + len(k) + len(desc) + 3 > w:
                break
            safe_addstr(win, y, x, k, th.c(P_SEL) | curses.A_BOLD)
            x += len(k)
            safe_addstr(win, y, x, f" {desc}", th.c(P_DIM))
            x += len(desc) + 2

    def draw_help(self, win, h, w) -> None:
        th = self.theme
        lines = [
            ("↑ / ↓ / j / k", "select a sensor"),
            ("PgUp / PgDn", "scroll by 10"),
            ("Home / End", "first / last sensor"),
            ("s", "sort: chip -> value -> name"),
            ("/", "filter by sensor or chip name"),
            ("c", "toggle °C / °F"),
            ("a", "chart scale: limit/reference <-> auto"),
            ("t", "show temperatures only / everything"),
            ("z", "show the dead sensors too"),
            ("h", "list of hidden sensors with the reason"),
            ("x", "hide / unhide the selected sensor"),
            ("d", "hide duplicates (the same measurement from two chips)"),
            ("w", "history window: sample -> 30 s -> 5 min"),
            ("u", "chip panel: temperatures ▲ / fan speeds ▼"),
            ("W", "save the settings and the hidden list to config.toml"),
            ("+ / -", "refresh interval (0.5-60 s)"),
            ("r", "reset min/max and the history"),
            ("space", "pause the readings"),
            ("q / Esc", "quit"),
        ]
        bw = min(w - 4, 58)
        bh = len(lines) + 4
        by = max(0, (h - bh) // 2)
        bx = max(0, (w - bw) // 2)
        for i in range(bh):
            safe_addstr(win, by + i, bx, " " * bw, th.c(P_TEXT))
        draw_box(win, by, bx, bh, bw, "help - sensortop", th)
        for i, (k, d) in enumerate(lines):
            safe_addstr(win, by + 1 + i, bx + 2, k.rjust(14), th.c(P_SEL) | curses.A_BOLD)
            safe_addstr(win, by + 1 + i, bx + 18, d[: bw - 20], th.c(P_TEXT))
        safe_addstr(
            win,
            by + bh - 2,
            bx + 2,
            "any key - back",
            th.c(P_DIM),
        )


def ratio_scale(r: Reading, hi: float) -> float:
    """Rescales the chart gradient so a 'cold' sensor is not entirely red."""
    if r.kind != "temp":
        return 1.0
    top, _src = temp_top(r)
    return clamp(hi / (top or TEMP_SCALE_FALLBACK), 0.25, 1.0)


