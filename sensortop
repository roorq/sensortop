# ---------------------------------------------------------------------------

# fnmatch patterns matched against the chip name; the most specific (longest)
# pattern wins, and entries from the config file beat the built-in ones.
DEFAULT_ALIASES = [
    ("k10temp-*", "CPU"),
    ("zenpower-*", "CPU"),
    ("coretemp-*", "CPU"),
    ("amdgpu-*", "GPU"),
    ("nouveau-*", "GPU"),
    ("radeon-*", "GPU"),
    ("i915-*", "iGPU"),
    ("nvme-*", "NVMe"),
    ("drivetemp-*", "disk"),
    ("spd5118-*", "RAM"),
    ("jc42-*", "RAM"),
    ("nct6*", "board"),
    ("it87*", "board"),
    ("it86*", "board"),
    ("asus*", "board"),
    ("r8169*", "NIC PHY"),
    ("igb-*", "NIC"),
    ("iwlwifi*", "WiFi"),
    ("mt79*", "WiFi PHY"),
    ("mt76*", "WiFi PHY"),
    ("ath1*", "WiFi"),
    ("acpitz-*", "ACPI"),
    ("BAT*", "battery"),
    ("ucsi_source_psy*", "USB-C"),
]

# ---------------------------------------------------------------------------
# Sensor role ranking - what the measurement is, not how high its bar stands
# ---------------------------------------------------------------------------

# The default hierarchy: (pattern "chip/label", class). Lower class = more important.
# The key is the (chip, label) pair, because only the chip says what the reading
# means: every RAM stick and every PHY carries a `temp1`. The lm-sensors `Adapter`
# field is no help here - both amdgpu and nvme report "PCI adapter".
#
# Neither the value nor the bar fill can be the primary criterion: hwmon limits are
# not comparable across chips. spd5118 reports high ~55 °C, so a RAM stick at 46 °C
# fills its bar more than GPU memory at 66 °C (limit 105 °C) - and it is the latter
# that is worth watching. The reading only decides within a class.
DEFAULT_PRIORITIES = [
    ("amdgpu-*/junction", 1),
    ("amdgpu-*/mem", 1),
    ("k10temp-*/Tctl", 2),
    ("amdgpu-*/edge", 3),
    ("nvme-*/Composite", 4),
    ("nct6*/SYSTIN", 5),
    ("nct6*/CPUTIN", 5),
]
# A sensor the map does not cover: the "rest" class (PHY, DIMM, AUXTIN, fans, voltages)
PRIORITY_FALLBACK = 6

CONFIG_DIR = os.path.join(
    os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
    "sensortop",
)
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.toml")
# the previous format - still read, so an old configuration is not lost
LEGACY_ALIASES = os.path.join(CONFIG_DIR, "aliases.conf")


def load_aliases(path: str = LEGACY_ALIASES) -> list[tuple[str, str]]:
    """Loads `pattern = alias` from the old aliases.conf file (# is a comment)."""
    rules: list[tuple[str, str]] = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.split("#", 1)[0].strip()
                if not line or "=" not in line:
                    continue
                pat, alias = line.split("=", 1)
                pat, alias = pat.strip(), alias.strip()
                if pat and alias:
                    rules.append((pat, alias))
    except OSError:
        pass
    return rules


