JSON_FAILURES_BEFORE_TEXT = 3


class SensorSource:
    """Reads sensors through `sensors`. Prefers JSON, falls back to text."""

    def __init__(self, extra_args: Optional[list[str]] = None):
        self.extra_args = extra_args or []
        self.mode = "json"
        self.last_error: Optional[str] = None
        self._json_worked = False
        self._json_failures = 0

    def available(self) -> Optional[str]:
        """Returns an error message if `sensors` cannot be run."""
        try:
            p = subprocess.run(
                ["sensors", "-v"], capture_output=True, text=True, timeout=5
            )
        except FileNotFoundError:
            return "Command `sensors` not found - install the lm-sensors package."
        except Exception as exc:  # noqa: BLE001
            return f"Cannot run `sensors`: {exc}"
        if p.returncode != 0 and not p.stdout:
            return "Command `sensors` returned an error: " + (p.stderr or "").strip()
        return None

    def read(self) -> list[Reading]:
        if self.mode == "json":
            out = self._read_json()
            if out is not None:
                self._json_worked = True
                self._json_failures = 0
                return out
            # A failure after JSON has worked is transient (a timeout, one bad
            # sample): use text for this sample only. Text mode is permanent
            # only for an lm-sensors that has never produced usable JSON.
            self._json_failures += 1
            if not self._json_worked and self._json_failures >= JSON_FAILURES_BEFORE_TEXT:
                self.mode = "text"
        return self._read_text()

    # -- JSON ---------------------------------------------------------------

    def _run(self, args: list[str]) -> Optional[str]:
        try:
            p = subprocess.run(
                ["sensors", *args, *self.extra_args],
                capture_output=True,
                text=True,
                timeout=10,
            )
        except Exception as exc:  # noqa: BLE001
            self.last_error = str(exc)
            return None
        if not p.stdout.strip():
            self.last_error = (p.stderr or "no data").strip()
            return None
        return p.stdout

    def _read_json(self) -> Optional[list[Reading]]:
        raw = self._run(["-j"])
        if raw is None:
            return None
        try:
            data = json.loads(raw)
        except json.JSONDecodeError:
            # Some drivers can emit invalid JSON (e.g. "nan" or "-nan").
            try:
                data = json.loads(re.sub(r"-?\bnan\b", "null", raw, flags=re.I))
            except json.JSONDecodeError:
                return None
        return self._from_json(data)

    @staticmethod
    def _from_json(data: dict) -> list[Reading]:
        out: list[Reading] = []
        for chip, feats in data.items():
            if not isinstance(feats, dict):
                continue
            adapter = str(feats.get("Adapter", ""))
            for label, sub in feats.items():
                if label == "Adapter" or not isinstance(sub, dict):
                    continue
                # amdgpu/power sometimes reports only *_average instead of *_input
                inp = next(
                    (k for k in sub if k.endswith("_input") and _isnum(sub[k])), None
                ) or next(
                    (k for k in sub if k.endswith("_average") and _isnum(sub[k])), None
                )
                if inp is None:
                    # the input exists but cannot be read (null/nan/I-O error)
                    broken = next((k for k in sub if k.endswith("_input")), None)
                    if broken:
                        kind_b = kind_from(broken)
                        out.append(
                            Reading(
                                chip=chip,
                                adapter=adapter,
                                label=label,
                                kind=kind_b,
                                value=float("nan"),
                                unit=KIND_UNITS.get(kind_b, ""),
                                error="no value in *_input",
                            )
                        )
                    continue
                prefix = inp.rsplit("_", 1)[0]
                kind = kind_from(prefix)

                def pick(*suffixes: str, _sub=sub, _pfx=prefix) -> Optional[float]:
                    for s in suffixes:
                        v = _sub.get(f"{_pfx}_{s}")
                        if _isnum(v):
                            return float(v)
                    return None

                out.append(
                    Reading(
                        chip=chip,
                        adapter=adapter,
                        label=label,
                        kind=kind,
                        value=float(sub[inp]),
                        high=sane_limit(kind, pick("max", "high", "cap")),
                        crit=sane_limit(kind, pick("crit", "emergency")),
                        low=sane_limit(kind, pick("min", "lcrit")),
                        unit=KIND_UNITS.get(kind, ""),
                    )
                )
        return out

    # -- text ---------------------------------------------------------------

    _RE_VALUE = re.compile(
        r"^(?P<label>[^:]{1,40}):\s+"
        r"(?P<val>[+-]?\d+(?:\.\d+)?)\s*"
        r"(?P<unit>°C|C|RPM|%|(?P<prefix>[numkMG]?)(?P<scaled>Hz|V|W|A|J))"
        r"(?P<rest>.*)$"
    )
    # each limit carries its own prefix: 912.00 mV (max = 1.20 V)
    _RE_LIMIT = re.compile(
        r"(?P<name>high|crit|max|min)\s*=\s*(?P<val>[+-]?\d+(?:\.\d+)?)\s*"
        r"(?:(?P<prefix>[numkMG]?)(?:Hz|V|W|A|J)\b)?"
    )
    _SI_PREFIX = {"n": 1e-9, "u": 1e-6, "m": 1e-3, "k": 1e3, "M": 1e6, "G": 1e9}
    # "temp1:  +40 C" has a colon ending the label; "r8169_0_a00:00-mdio-0" does not
    _RE_LABEL_END = re.compile(r":(?:\s|$)")
    # ERROR: Can't get value of subfeature temp3_input: I/O error
    _RE_ERROR = re.compile(
        r"^ERROR:\s*Can't get value of subfeature\s+(?P<sub>\w+):\s*(?P<why>.+)$"
    )

    def _read_text(self) -> list[Reading]:
        raw = self._run([])  # without -A, so the "Adapter:" lines are captured too
        if raw is None:
            return []
        out: list[Reading] = []
        chip = "?"
        adapter = ""
        mult = 1.0  # the scale of the last value, for limits printed without a unit
        for line in raw.splitlines():
            if not line.strip():
                continue
            if not line[0].isspace() and not self._RE_LABEL_END.search(line):
                chip, adapter = line.strip(), ""
                continue
            if line.startswith("Adapter:"):
                adapter = line.split(":", 1)[1].strip()
                continue
            err = self._RE_ERROR.match(line.strip())
            if err:
                sub = err.group("sub")
                kind_e = kind_from(sub)
                out.append(
                    Reading(
                        chip=chip,
                        adapter=adapter,
                        label=sub.rsplit("_", 1)[0],
                        kind=kind_e,
                        value=float("nan"),
                        unit=KIND_UNITS.get(kind_e, ""),
                        error=err.group("why").strip(),
                    )
                )
                continue
            if line[0].isspace() and line.lstrip().startswith("(") and out and out[-1].chip == chip:
                self._apply_limits(out[-1], line, mult)  # limits wrapped to their own line
                continue
            m = self._RE_VALUE.match(line.strip())
            if not m:
                continue
            unit = m.group("scaled") or m.group("unit")
            unit = "°C" if unit in ("C", "°C") else unit
            kind = {
                "°C": "temp",
                "RPM": "fan",
                "Hz": "freq",
                "V": "in",
                "W": "power",
                "A": "curr",
                "J": "energy",
                "%": "humidity",
            }.get(unit, "temp")
            # the text `sensors` prints scaled values - the model keeps base units
            mult = self._SI_PREFIX.get(m.group("prefix") or "", 1.0)
            reading = Reading(
                chip=chip,
                adapter=adapter,
                label=m.group("label").strip(),
                kind=kind,
                value=float(m.group("val")) * mult,
                unit=KIND_UNITS.get(kind, unit),
            )
            self._apply_limits(reading, m.group("rest"), mult)
            out.append(reading)
        return out

    def _apply_limits(self, r: Reading, text: str, mult: float) -> None:
        """Fills the limits still missing from a `(high = ..., crit = ...)` fragment."""
        limits = {}
        for m in self._RE_LIMIT.finditer(text):
            prefix = m.group("prefix")
            scale = mult if prefix is None else self._SI_PREFIX.get(prefix, 1.0)
            limits[m.group("name")] = float(m.group("val")) * scale
        if r.high is None:
            r.high = sane_limit(r.kind, limits.get("high", limits.get("max")))
        if r.crit is None:
            r.crit = sane_limit(r.kind, limits.get("crit"))
        if r.low is None:
            r.low = sane_limit(r.kind, limits.get("min"))


