ANSI = {
    "reset": "\033[0m",
    "bold": "\033[1m",
    "dim": "\033[2m",
}


def once(source, args, cfg: Optional[Config] = None) -> int:
    data = source.read()
    if not data:
        print("no readings from `sensors`", file=sys.stderr)
        return 1
    app = App(source, args, cfg)
    app.ingest(data)  # a single sample: the floor, the aliases, the [hidden] rules
    # with one sample the zero, physical-range, read-error and manual-hide rules
    # all work; duplicate detection needs history, so it drops out
    hidden = {r.key: why for r in app.readings if (why := app.dead(r))}
    data = [r for r in app.readings if args.show_dead or r.key not in hidden]

    if args.json:
        print(json.dumps(json_dump(app, data, hidden), ensure_ascii=False, indent=2))
        return 0

    color = sys.stdout.isatty() and not args.mono
    heat = [82, 118, 154, 190, 226, 220, 214, 208, 202, 196]
    cool = [25, 26, 32, 38, 44, 45, 45, 51, 51, 87]

    def paint(s: str, ratio: float, palette="heat", bold=False) -> str:
        if not color:
            return s
        pal = heat if palette == "heat" else cool
        c = pal[int(clamp(ratio, 0, 1) * (len(pal) - 1) + 0.5)]
        b = ANSI["bold"] if bold else ""
        return "\033[38;5;%dm%s%s%s" % (c, b, s, ANSI["reset"])

    chips: dict[str, list[Reading]] = {}
    for r in data:
        chips.setdefault(r.chip, []).append(r)
    width = min(os.get_terminal_size().columns if sys.stdout.isatty() else 80, 100)
    bar_w = max(10, width - 48)
    for chip, lst in chips.items():
        alias = app.namer.alias(chip)
        head = f"{alias}  ({chip})"
        print(f"\033[1;36m{alias}{ANSI['reset']}  \033[2m({chip}){ANSI['reset']}" if color else head)
        for r in sorted(lst, key=lambda r: (KIND_ORDER.get(r.kind, 9), r.label)):
            st = app.stats.setdefault(r.key, Stats())
            pal = palette_of(r)
            ratio = ratio_of(r, st, app.refs)
            if ratio is None:
                bar = " " * bar_w  # no reference - draw nothing
            else:
                n = int(ratio * bar_w)
                bar = paint("█" * n + "·" * (bar_w - n), ratio, pal)
            lim = ""
            if r.crit is not None:
                lim = f"  crit {app.fmt(r, r.crit).strip()}"
            elif r.high is not None:
                lim = f"  high {app.fmt(r, r.high).strip()}"
            if r.kind == "temp":
                val = paint(app.fmt(r), ratio or 0.0, pal, bold=True)
            else:
                val = f"{ANSI['bold']}{app.fmt(r)}{ANSI['reset']}" if color else app.fmt(r)
            dim, rst = (ANSI["dim"], ANSI["reset"]) if color else ("", "")
            print(f"  {r.label[:20]:<20} {bar} {val}{dim}{lim}{rst}")
        print()
    return 0


ALARM_NAMES = ["ok", "warn", "crit"]


def json_dump(app: "App", data: list[Reading], hidden: dict) -> dict:
    """A normalised dump for alerting: the readings + limit and state context."""
    temps = [r for r in data if r.kind == "temp" and r.valid]
    lo, hi = app.range_now()
    sensors = []
    for r in data:
        st = app.stats.setdefault(r.key, Stats())
        sensors.append(
            {
                "chip": r.chip,
                "alias": app.namer.alias(r.chip),
                "adapter": r.adapter,
                "label": r.label,
                "name": app.namer.qualified(r),
                "kind": r.kind,
                "value": None if math.isnan(r.value) else r.value,
                "unit": r.unit,
                "pretty": app.fmt(r).strip(),
                "high": r.high,
                "crit": r.crit,
                "low": r.low,
                "ratio": ratio_of(r, st, app.refs),
                "state": ALARM_NAMES[alarm_level(r)],
                "hidden": hidden.get(r.key),
                "error": r.error,
            }
        )
    hottest = max(temps, key=lambda r: r.value, default=None)
    return {
        "host": app.host,
        "time": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "unix": int(time.time()),
        "temp_range": {"min": lo, "max": hi, "auto": app.temp_range[0] is None},
        "summary": {
            "sensors": len(sensors),
            "temps": len(temps),
            "hidden": len(hidden),
            "warn": sum(1 for r in data if alarm_level(r) > 0),
            "max_temp": (
                None
                if hottest is None
                else {"name": app.namer.qualified(hottest), "value": hottest.value}
            ),
            "avg_temp": (
                round(sum(r.value for r in temps) / len(temps), 2) if temps else None
            ),
        },
        "sensors": sensors,
    }


def write_config(source, path: str) -> int:
    """Writes a config template with the detected chips - ready to edit."""
    if os.path.exists(path):
        print(f"File {path} already exists - not overwriting.", file=sys.stderr)
        return 1
    data = source.read()
    namer = ChipNamer()
    chips = list(dict.fromkeys(r.chip for r in data))
    namer.rebuild(chips)
    cfg = Config(
        path=path,
        aliases=detected_aliases(namer, chips),
        priorities=list(DEFAULT_PRIORITIES),
    )
    cfg.alias_notes = {
        chip: ", ".join(sorted({r.kind for r in data if r.chip == chip})) for chip in chips
    }
    try:
        cfg.save()
    except OSError as exc:
        print(f"Could not save {path}: {exc.strerror or exc}", file=sys.stderr)
        return 1
    print(f"Saved {path} ({len(chips)} chips). Edit it and run again.")
    return 0


def parse_temp_range(text: str) -> tuple[Optional[float], float]:
    """'auto:130' -> (None, 130.0); '12:130' -> (12.0, 130.0). None = dynamic floor."""
    lo_s, _, hi_s = str(text).partition(":")
    lo_s, hi_s = lo_s.strip().lower(), hi_s.strip()
    lo = None if lo_s in ("auto", "") else float(lo_s)
    hi = float(hi_s) if hi_s else TEMP_PHYSICAL[1]
    if lo is not None and lo >= hi:
        raise ValueError("MIN >= MAX")
    return lo, hi


# config key name -> argparse field name (where they differ)
CFG_TO_ARG = {"range": "temp_range"}


def resolve_settings(args, cfg: Config) -> None:
    """Order of precedence: CLI flag > config.toml > built-in value."""
    for section, spec in ((cfg.ui, UI_SETTINGS), (cfg.temps, TEMP_SETTINGS)):
        for key, (_typ, default) in spec.items():
            dest = CFG_TO_ARG.get(key, key)
            if getattr(args, dest, None) is None:
                setattr(args, dest, section.get(key, default))


