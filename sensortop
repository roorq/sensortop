@dataclass
class Reading:
    """A single sensor reading."""

    chip: str
    adapter: str
    label: str
    kind: str
    value: float
    high: Optional[float] = None
    crit: Optional[float] = None
    low: Optional[float] = None
    unit: str = ""
    error: Optional[str] = None  # e.g. no *_input, or a read error from hwmon

    @property
    def key(self) -> str:
        """Sensor identity: (adapter, chip, label).

        The label alone identifies nothing - every RAM stick and every PHY
        carries a `temp1`. The adapter and the chip have to be part of the
        key so two sensors with the same name never share one history.
        """
        return f"{self.adapter}\x00{self.chip}\x00{self.label}"

    @property
    def valid(self) -> bool:
        return self.error is None and not math.isnan(self.value)


class Ring:
    """A fixed-capacity ring buffer - the list is allocated once, on creation.

    The memory per sensor is known up front (`cap` slots) and does not depend
    on how long the program runs: once full, the oldest sample is overwritten
    in place, with no `append`/`pop` and no reallocation of the list.

    The interface deliberately matches a list in the few places the rest of the
    program uses (`len`, iteration, `clear`), so the renderers accept both the
    buffer and a plain list from a test. `tail(n)` is a faster route to "the
    last n samples" than `list(...)[-n:]`, which copies the whole buffer.
    """

    __slots__ = ("buf", "cap", "pos", "n")

    def __init__(self, cap: int = HISTORY_CAP):
        self.cap = max(1, int(cap))
        self.buf = [0.0] * self.cap  # preallocated - from here on only slot swaps
        self.pos = 0  # index the next sample goes into
        self.n = 0  # how many slots are actually filled

    def append(self, v: float) -> None:
        self.buf[self.pos] = v
        self.pos = (self.pos + 1) % self.cap
        if self.n < self.cap:
            self.n += 1

    def clear(self) -> None:
        self.pos = self.n = 0

    def tail(self, k: int) -> list:
        """The last k samples in chronological order (a copy)."""
        k = min(max(int(k), 0), self.n)
        if k == 0:
            return []
        start = (self.pos - k) % self.cap
        end = start + k
        if end <= self.cap:
            return self.buf[start:end]
        return self.buf[start:] + self.buf[: end - self.cap]

    def __len__(self) -> int:
        return self.n

    def __iter__(self):
        return iter(self.tail(self.n))

    def __repr__(self) -> str:  # pragma: no cover - debugging only
        return f"Ring({self.n}/{self.cap})"


def tail_of(series, n: int) -> list:
    """The last n items - from a `Ring` without copying it all, from a list plainly."""
    fast = getattr(series, "tail", None)
    return fast(n) if fast is not None else list(series)[-n:] if n > 0 else []


class Bucket(NamedTuple):
    """A bucket of an aggregated window: the extremes and mean of several samples."""

    lo: float
    avg: float
    hi: float


def aggregate(series, bucket: int) -> list:
    """Splits a series into buckets of `bucket` samples: (min, mean, max).

    The split runs from the end: the newest sample always closes the last
    bucket, so the panel reacts to the current reading and the incomplete
    remainder lands on the left - where the oldest history sits anyway. The
    other way round (splitting from the start) the last bucket grows in front
    of the user and jumps once it closes.
    """
    data = list(series)
    if bucket <= 1:
        return [Bucket(v, v, v) for v in data]
    out = []
    edge = len(data) % bucket
    if edge:
        head = data[:edge]
        out.append(Bucket(min(head), sum(head) / edge, max(head)))
    for i in range(edge, len(data), bucket):
        chunk = data[i : i + bucket]
        out.append(Bucket(min(chunk), sum(chunk) / bucket, max(chunk)))
    return out


def fmt_span(seconds: float) -> str:
    """The window duration in a form that fits the panel frame."""
    if seconds < 60:
        return f"{seconds:g}s"
    if seconds < 3600:
        m = seconds / 60
        return f"{m:g} min" if m == int(m) else f"{m:.1f} min"
    h = seconds / 3600
    return f"{h:g} h" if h == int(h) else f"{h:.1f} h"


@dataclass
class Stats:
    """History and session statistics for a single sensor."""

    hist: Ring = field(default_factory=Ring)
    vmin: float = math.inf
    vmax: float = -math.inf
    total: float = 0.0
    count: int = 0

    def push(self, v: float) -> None:
        self.hist.append(v)
        self.vmin = min(self.vmin, v)
        self.vmax = max(self.vmax, v)
        self.total += v
        self.count += 1

    @property
    def avg(self) -> float:
        return self.total / self.count if self.count else 0.0

    def reset(self) -> None:
        self.vmin = math.inf
        self.vmax = -math.inf
        self.total = 0.0
        self.count = 0


