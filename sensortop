def main(argv=None) -> int:
    set_proc_name("sensortop")
    ap = argparse.ArgumentParser(
        prog="sensortop",
        description="A btop-style temperature monitor built on lm-sensors.",
    )
    # Flags with no default (None) are filled in from config.toml - otherwise
    # "not given" could not be told apart from "given the default value".
    ap.add_argument(
        "-i",
        "--interval",
        type=float,
        default=None,
        help="refresh interval in seconds (default 2)",
    )
    ap.add_argument(
        "-f",
        "--fahrenheit",
        action="store_true",
        default=None,
        help="temperatures in degrees Fahrenheit",
    )
    ap.add_argument(
        "-t",
        "--temps-only",
        action="store_true",
        default=None,
        help="show temperature sensors only",
    )
    ap.add_argument(
        "-s",
        "--sort",
        choices=SORTS,
        default=None,
        help="list order: chip / value / name (default chip)",
    )
    ap.add_argument(
        "-1",
        "--once",
        action="store_true",
        help="a one-off dump instead of the TUI (text, or JSON on stdout with --json)",
    )
    ap.add_argument(
        "--json",
        action="store_true",
        help="normalised JSON on stdout; implies --once (for alerting)",
    )
    ap.add_argument(
        "--mono", action="store_true", default=None, help="monochrome mode (no colours)"
    )
    ap.add_argument(
        "--ascii",
        action="store_true",
        default=None,
        help="ASCII charts instead of braille (braille by default, with "
        "autodetection - on a terminal without U+28FF the fallback turns itself on)",
    )
    ap.add_argument(
        "--demo", action="store_true", help="synthetic data - a look at the UI without lm-sensors"
    )
    ap.add_argument(
        "-z",
        "--show-dead",
        action="store_true",
        default=None,
        help="do not hide the dead sensors (constant 0, out of range, hidden manually)",
    )
    ap.add_argument(
        "--hide-stale",
        action="store_true",
        default=None,
        help="an extra criterion: hide sensors unchanged for N samples "
        "(off by default - a stable reading is usually a working sensor)",
    )
    ap.add_argument(
        "--dead-after",
        type=int,
        default=None,
        metavar="N",
        help="how many identical samples count as 'unchanged' for --hide-stale "
        "(default 20)",
    )
    ap.add_argument(
        "--temp-range",
        default=None,
        metavar="MIN:MAX",
        help="the temperature range considered possible; MIN=auto computes the "
        "floor from the trustworthy sensors (default auto:130)",
    )
    ap.add_argument(
        "--floor-margin",
        type=float,
        default=None,
        metavar="°C",
        help="how many degrees below the coldest trustworthy sensor the floor "
        f"lands with MIN=auto (default {TEMP_FLOOR_MARGIN:g})",
    )
    ap.add_argument(
        "-d",
        "--hide-duplicates",
        action="store_true",
        default=None,
        help="hide sensors measuring the same thing as another chip (e.g. TSI0_TEMP = Tctl); "
        f"detection needs at least {DUPE_MIN_SAMPLES} samples, so it works in the TUI, not in --once",
    )
    ap.add_argument(
        "--hwmon-root",
        default="/sys/class/hwmon",
        help="the hwmon directory holding the reference points (power1_cap, pp_dpm_*)",
    )
    ap.add_argument(
        "--config",
        default=CONFIG_PATH,
        help=f"the configuration file (default {CONFIG_PATH})",
    )
    ap.add_argument(
        "--write-config",
        action="store_true",
        help="write a config template for the detected chips and exit",
    )
    ap.add_argument(
        "--sensors-arg",
        action="append",
        default=[],
        help="an extra argument passed to `sensors` (may be repeated)",
    )
    ap.add_argument("-V", "--version", action="version", version=f"sensortop {VERSION}")
    args = ap.parse_args(argv)

    cfg = Config.load(args.config)
    if cfg.error:
        print(f"⚠ {cfg.error}", file=sys.stderr)
    resolve_settings(args, cfg)

    args.interval = max(0.2, args.interval)
    try:
        args.temp_range = parse_temp_range(args.temp_range)
    except ValueError:
        ap.error("--temp-range expects MIN:MAX or auto:MAX, e.g. auto:130")
    source = DemoSource() if args.demo else SensorSource(args.sensors_arg)

    err = source.available()
    if err:
        print(err, file=sys.stderr)
        print("Hint: run `sensortop --demo` to see the interface.", file=sys.stderr)
        return 2

    if args.write_config:
        return write_config(source, args.config)

    if args.once or args.json:
        return once(source, args, cfg)

    app = App(source, args, cfg)
    set_term_title("sensortop")
    try:
        curses.wrapper(app.run)
    except KeyboardInterrupt:
        pass
    finally:
        restore_term_title()
    return 0


if __name__ == "__main__":
    sys.exit(main())
