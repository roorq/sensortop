# Colours
# ---------------------------------------------------------------------------

# Colour pairs: P_GRAD.. is the "heat" gradient (green -> yellow -> red),
# P_COOL.. is the neutral palette (navy -> light blue) for quantities that have
# nothing to do with an alarm: fan speeds, frequencies, voltages, power.
GRAD_N = 11
P_GRAD = 1
P_COOL = 40
P_TITLE = 20
P_FRAME = 21
P_DIM = 22
P_TEXT = 23
P_SEL = 24
P_WARN = 25
P_CRIT = 26
P_HDR = 27
P_ACCENT = 28
P_VALUE = 29  # the fixed text colour of non-temperature values


def init_colors(mono: bool) -> bool:
    """Initialises the colour pairs. Returns True if colours are available."""
    if mono or not curses.has_colors():
        return False
    curses.start_color()
    try:
        curses.use_default_colors()
        bg = -1
    except curses.error:
        bg = curses.COLOR_BLACK

    if curses.COLORS >= 256:
        # a path through the 6x6x6 cube: green (0,5,0) -> yellow (5,5,0) -> red (5,0,0)
        grad = [16 + 36 * r + 6 * 5 for r in range(6)] + [
            16 + 36 * 5 + 6 * g for g in (4, 3, 2, 1, 0)
        ]
        # blue -> light blue -> bright cyan; no dark shades, which are all but
        # invisible on a black background
        cool = [26, 32, 32, 38, 39, 44, 45, 45, 51, 87, 123]
        ui = {
            P_TITLE: 51,
            P_FRAME: 240,
            P_DIM: 244,
            P_TEXT: 252,
            P_SEL: 45,
            P_WARN: 214,
            P_CRIT: 196,
            P_HDR: 117,
            P_ACCENT: 111,
            P_VALUE: 159,
        }
    else:
        grad = [
            curses.COLOR_GREEN,
            curses.COLOR_GREEN,
            curses.COLOR_GREEN,
            curses.COLOR_CYAN,
            curses.COLOR_CYAN,
            curses.COLOR_YELLOW,
            curses.COLOR_YELLOW,
            curses.COLOR_YELLOW,
            curses.COLOR_MAGENTA,
            curses.COLOR_RED,
            curses.COLOR_RED,
        ]
        cool = [curses.COLOR_BLUE] * 6 + [curses.COLOR_CYAN] * 5
        ui = {
            P_TITLE: curses.COLOR_CYAN,
            P_FRAME: curses.COLOR_BLUE,
            P_DIM: curses.COLOR_WHITE,
            P_TEXT: curses.COLOR_WHITE,
            P_SEL: curses.COLOR_CYAN,
            P_WARN: curses.COLOR_YELLOW,
            P_CRIT: curses.COLOR_RED,
            P_HDR: curses.COLOR_CYAN,
            P_ACCENT: curses.COLOR_BLUE,
            P_VALUE: curses.COLOR_CYAN,
        }

    for i, c in enumerate(grad[:GRAD_N]):
        curses.init_pair(P_GRAD + i, c, bg)
    for i, c in enumerate(cool[:GRAD_N]):
        curses.init_pair(P_COOL + i, c, bg)
    for pair, c in ui.items():
        curses.init_pair(pair, c, bg)
    return True


class Theme:
    """Access to the colour attributes (with a graceful fallback to mono mode)."""

    def __init__(self, colored: bool):
        self.colored = colored

    def grad(self, t: float, palette: str = "heat") -> int:
        """A colour from a palette: 'heat' for temperatures, 'cool' for everything else."""
        if not self.colored:
            return curses.A_NORMAL
        idx = int(clamp(t, 0, 1) * (GRAD_N - 1) + 0.5)
        base = P_GRAD if palette == "heat" else P_COOL
        return curses.color_pair(base + idx)

    def c(self, pair: int) -> int:
        return curses.color_pair(pair) if self.colored else curses.A_NORMAL


