def clamp(v: float, lo: float, hi: float) -> float:
    return lo if v < lo else hi if v > hi else v


def to_f(c: float) -> float:
    return c * 9.0 / 5.0 + 32.0


def fmt_freq(hz: float) -> str:
    """Raw hwmon Hz into a readable unit: 1436000000.0 -> 1.44 GHz."""
    a = abs(hz)
    if a >= 1e9:
        return f"{hz / 1e9:5.2f} GHz"
    if a >= 1e6:
        return f"{hz / 1e6:5.0f} MHz"
    if a >= 1e3:
        return f"{hz / 1e3:5.0f} kHz"
    return f"{hz:5.0f} Hz"


def palette_of(r: Reading) -> str:
    """Only temperatures get the alarm palette; everything else stays neutral."""
    return "heat" if r.kind == "temp" else "cool"


def reference_top(r: Reading, refs=None) -> Optional[tuple[float, str]]:
    """The fixed upper reference of a bar: (value, source). None = no basis.

    The session range is deliberately not used: with a few samples min == max,
    so every bar would come out full (or empty) regardless of the reading.
    """
    if r.kind == "fan":
        if r.high:
            return r.high, "fan*_max"
        if refs:
            v = refs.fan_max(r.chip, r.label)
            if v:
                return v, "fan*_max"
        if any(h in r.label.lower() for h in PUMP_HINTS):
            return DEFAULT_PUMP_TOP, "pump default"
        return DEFAULT_FAN_TOP, "case-fan default"
    if r.kind == "power":
        if r.high:
            return r.high, "power1_cap"
        if refs:
            v = refs.power_cap(r.chip)
            if v:
                return v, "power1_cap"
        return None
    if r.kind == "freq":
        if r.high:
            return r.high, "freq*_max"
        if refs:
            v = refs.freq_top(r.chip, r.label)
            if v:
                return v, f"pp_dpm_{r.label.lower()}"
        return None
    if r.kind == "in":
        for step in VOLT_LADDER:
            if abs(r.value) <= step:
                return step, f"{step:g} V rail"
        return abs(r.value), "reading"
    if r.kind == "curr" and r.high:
        return r.high, "curr*_max"
    return None


# Bottom of the temperature scale: below 20 °C there is nothing to look at
TEMP_SCALE_FLOOR = 20.0
# When the driver reports no limit at all, the bar still needs a reference
TEMP_SCALE_FALLBACK = 100.0


def usable_temp_limit(value: Optional[float]) -> bool:
    """False for missing limits and for placeholders such as temp1_crit = 0."""
    return value is not None and value > TEMP_SCALE_FLOOR


def temp_top(r: Reading) -> tuple[Optional[float], str]:
    """The upper temperature reference: (value, limit name) or (None, "").

    `high` takes precedence over `crit`: it is the working limit at which the
    hardware starts defending itself, not the emergency shutdown boundary. One
    source for the bar and for the chart - otherwise the same 41 °C would mean
    something different in each panel.
    """
    for value, name in ((r.high, "high limit"), (r.crit, "crit limit")):
        if usable_temp_limit(value):
            return value, name
    return None, ""


def scale_range(r: Reading, stats: Stats, refs=None) -> Optional[tuple[float, float]]:
    """The (bottom, top) range of a bar, or None when there is no sane reference."""
    if r.kind == "temp":
        top, _src = temp_top(r)
        return TEMP_SCALE_FLOOR, max(top or TEMP_SCALE_FALLBACK, 40.0)
    ref = reference_top(r, refs)
    if ref is None or ref[0] <= 0:
        return None
    return 0.0, ref[0]


def graph_range(r: Reading, stats: Stats, refs=None) -> Optional[tuple[float, float, str]]:
    """The vertical scale of the history panel: (bottom, top, source), or None = autoscale.

    It is the same scale as the bar uses (`scale_range`), so the bar fill and
    the chart height mean the same thing: 20 °C -> the hwmon limit. The chart
    is meant to show the distance to the limit, not the shape of the noise -
    scaled to the observed maximum every sensor looks equally dramatic.

    There is one difference from the bar: a sensor without any limit has
    nothing to be scaled against, so instead of an invented 100 °C it falls
    back to autoscaling (the details panel notes that).
    """
    if r.kind == "temp":
        top, src = temp_top(r)
        if top is None:
            return None
        lo, hi = scale_range(r, stats, refs)
        return lo, hi, src
    rng = scale_range(r, stats, refs)
    if rng is None:
        return None
    if r.kind == "in" and r.value < 0:
        return None  # the 0..rail scale would clip a negative rail to an empty chart
    src = reference_top(r, refs)
    return rng[0], rng[1], (src[1] if src else "reference")


def graph_threshold(r: Reading) -> Optional[tuple[float, str]]:
    """The limit drawn on the chart as a horizontal line - the same one that sets the scale."""
    if r.kind != "temp":
        return None
    top, src = temp_top(r)
    return None if top is None else (top, src)


def ratio_of(r: Reading, stats: Stats, refs=None) -> Optional[float]:
    """The bar fill 0..1, or None when the scale is unknown."""
    if math.isnan(r.value):
        return None
    rng = scale_range(r, stats, refs)
    if rng is None:
        return None
    lo, hi = rng
    value = abs(r.value) if r.kind == "in" else r.value  # -12 V fills a bar like +12 V
    return clamp((value - lo) / (hi - lo) if hi > lo else 0.0, 0.0, 1.0)


def mirrors(
    ha,
    hb,
    tol: float = DUPE_TOLERANCE,
    min_samples: int = DUPE_MIN_SAMPLES,
    agreement: float = DUPE_AGREEMENT,
    window: int = DUPE_WINDOW,
) -> bool:
    """Are two series of readings the same measurement?

    The criterion is purely quantitative: the readings differ by less than
    `tol` in at least an `agreement` fraction of the last N samples. Names,
    labels and adapters play no part in it.

    With N < `min_samples` the answer is "I do not know", which is not the same
    as "yes" - absence of data is not proof, so nothing gets flagged.
    """
    n = min(len(ha), len(hb), window)
    if n < min_samples:
        return False
    a, b = tail_of(ha, n), tail_of(hb, n)
    close = sum(1 for x, y in zip(a, b) if abs(x - y) < tol)
    return close >= agreement * n


def trusted_temps(readings) -> list:
    """The temperature sensors we trust: those for which the driver gave a limit.

    A driver that knows the `high`/`crit` of an input also knows what that
    input measures. The free Super I-O inputs (AUXTIN*) have no limits, and
    they are exactly the ones returning a random voltage converted to degrees.
    """
    lo, hi = TEMP_PHYSICAL
    return [
        r
        for r in readings
        if r.kind == "temp"
        and r.valid
        and (r.high is not None or r.crit is not None)
        and lo <= r.value <= hi
    ]


def dynamic_floor(
    readings,
    margin: float = TEMP_FLOOR_MARGIN,
    cap: float = TEMP_FLOOR_CAP,
    hard: float = TEMP_PHYSICAL[0],
) -> float:
    """The floor below which a temperature is physically impossible in this case.

    A fixed 5 °C lets junk through (AUXTIN1 = 6.0 with a 35 °C average) because
    it knows nothing about the conditions. The reference points are the coldest
    trustworthy sensors - nothing in a running computer is `margin` degrees
    colder than those. The result is clamped to [hard, cap], so a hot system
    cannot drag the floor absurdly high.
    """
    ref = trusted_temps(readings)
    if not ref:
        return hard
    return clamp(min(r.value for r in ref) - margin, hard, cap)


def dead_reason(
    r: Reading,
    stats: Stats,
    after: int = 20,
    temp_range: tuple[float, float] = TEMP_PHYSICAL,
    hide_stale: bool = False,
) -> Optional[str]:
    """Is the sensor bogus? Returns the reason, or None.

    The default criteria (each decisive on its own):
      1. the reading is exactly 0.0 for the whole session,
      2. the reading is outside the physical range (temperatures: temp_range),
      3. no *_input in sysfs, or a read error reported by the driver.
    Stability of the value alone is NOT evidence - a stable sensor is usually a
    working sensor. The "unchanged for N samples" criterion is optional
    (hide_stale) and off by default.
    """
    if r.error:  # (3)
        return f"read error: {r.error}"
    if math.isnan(r.value):
        return "no value (*_input)"

    low = r.label.lower()
    if any(fnmatch.fnmatch(low, p) for p in JUNK_LABELS):
        return "calibration entry, not a measuring point"

    if stats.count == 0:
        return None
    if stats.vmin == 0.0 and stats.vmax == 0.0:  # (1)
        return "constant 0.0 for the whole session"
    if r.kind == "temp":  # (2)
        lo, hi = temp_range
        if stats.vmax < lo or stats.vmin > hi:
            return f"outside the physical range ({lo:g}-{hi:g} °C)"
    if hide_stale and stats.count >= after and stats.vmin == stats.vmax:
        return f"unchanged for {stats.count} samples"
    return None


def alarm_level(r: Reading) -> int:
    """0 = ok, 1 = the high limit is exceeded, 2 = the critical limit is exceeded."""
    if r.kind != "temp":
        return 0
    crit = r.crit if usable_temp_limit(r.crit) else None
    high = r.high if usable_temp_limit(r.high) else None
    if crit is not None and r.value >= crit:
        return 2
    if high is not None and r.value >= high:
        return 1
    if crit is not None and r.value >= crit * 0.92:
        return 1
    return 0


# Block characters for the bars (from 1/8 to 8/8)
BLOCKS = " ▏▎▍▌▋▊▉█"
# Braille bit mapping: DOT[row_in_cell][column_in_cell]
DOT = [(0x01, 0x08), (0x02, 0x10), (0x04, 0x20), (0x40, 0x80)]


def braille_area(
    series, width: int, height: int, ymin: float, ymax: float
) -> list[str]:
    """An area chart in braille characters - 2x4 dots per cell."""
    if width <= 0 or height <= 0:
        return []
    cells = [[0] * width for _ in range(height)]
    slots = width * 2
    data = tail_of(series, slots)
    offset = slots - len(data)
    py = height * 4
    span = ymax - ymin
    for i, v in enumerate(data):
        pos = offset + i
        col, sub = pos // 2, pos % 2
        t = clamp((v - ymin) / span if span > 0 else 0.5, 0.0, 1.0)
        top = int(round((1.0 - t) * (py - 1)))
        for rd in range(top, py):
            cells[rd // 4][col] |= DOT[rd % 4][sub]
    return ["".join(chr(0x2800 + c) for c in row) for row in cells]


def row_at(value: float, lo: float, hi: float, height: int) -> Optional[int]:
    """The chart row a given value falls into. None = out of range."""
    if height <= 0 or hi <= lo or not (lo <= value <= hi):
        return None
    return int(round((1.0 - (value - lo) / (hi - lo)) * (height - 1)))


# Fallback for terminals/locales without braille: one sample per column.
ASCII_LEVELS = "_.-~^"
ASCII_FILL = "#"


def ascii_area(series, width: int, height: int, ymin: float, ymax: float) -> list[str]:
    """An area chart in plain ASCII - character resolution, not dot resolution."""
    if width <= 0 or height <= 0:
        return []
    cells = [[" "] * width for _ in range(height)]
    data = tail_of(series, width)
    offset = width - len(data)
    span = ymax - ymin
    for i, v in enumerate(data):
        col = offset + i
        t = clamp((v - ymin) / span if span > 0 else 0.5, 0.0, 1.0)
        top = int(round((1.0 - t) * (height - 1)))
        for row in range(top, height):
            cells[row][col] = ASCII_FILL
    return ["".join(row) for row in cells]


def ascii_line(series, width: int) -> str:
    """An ASCII sparkline: the five-level ramp `_.-~^`."""
    data = tail_of(series, width)
    if not data:
        return " " * width
    lo, hi = min(data), max(data)
    span = hi - lo
    out = []
    for v in data:
        t = clamp((v - lo) / span if span > 0 else 0.5, 0.0, 1.0)
        out.append(ASCII_LEVELS[int(round(t * (len(ASCII_LEVELS) - 1)))])
    return "".join(out).rjust(width)


def braille_supported(win=None) -> bool:
    """Can the locale and the terminal handle U+2800..U+28FF?

    It asks the locale first (curses encodes its output with exactly that),
    then - if we have a window - actually tries to write U+28FF. A terminal
    that cannot do it raises an error instead of drawing garbage.
    """
    enc = getattr(sys.stdout, "encoding", None) or locale.getpreferredencoding(False)
    try:
        "⣿".encode(enc or "ascii")
    except (UnicodeEncodeError, LookupError, TypeError):
        return False
    if win is None:
        return True
    try:
        win.addstr(0, 0, "⣿")
    except (curses.error, UnicodeError, ValueError):
        return False
    finally:
        try:
            win.erase()
        except curses.error:
            pass
    return True


def braille_line(series, width: int) -> str:
    """A single-row braille sparkline (4 levels)."""
    data = tail_of(series, width * 2)
    if not data:
        return " " * width
    lo, hi = min(data), max(data)
    span = hi - lo
    cells = [0] * width
    offset = width * 2 - len(data)
    for i, v in enumerate(data):
        pos = offset + i
        col, sub = pos // 2, pos % 2
        t = clamp((v - lo) / span if span > 0 else 0.5, 0.0, 1.0)
        row = 3 - int(round(t * 3))
        cells[col] |= DOT[row][sub]
    return "".join(chr(0x2800 + c) for c in cells)


# The mean marker in ASCII mode - it has to differ from the band fill (`#`),
# because ASCII has no subpixels and the mean line has nothing to stand out
# with beyond the shape of the character itself.
ASCII_MEAN = "="


def _dot(grid, row: int, col: int, sub: int, braille: bool) -> None:
    """Lights a dot (braille) or a whole cell (ASCII) in the mask grid."""
    if braille:
        grid[row // 4][col] |= DOT[row % 4][sub]
    else:
        grid[row][col] = 1


def cell_grid(
    cols,
    width: int,
    height: int,
    ymin: float,
    ymax: float,
    repeat: int = 1,
    band: bool = False,
    braille: bool = True,
    down: bool = False,
) -> tuple[list, list]:
    """Mask grids for one series of buckets: (the min-max band, the mean).

    Masks are returned rather than finished characters, because the dual-axis
    panel composes several series into one cell and has to know which of them
    took it - in curses the colour is an attribute of the cell, not of the dot.

    `repeat` is the width of one bucket in slots (braille: 2 slots = a cell),
    which keeps the 5-minute window from shrinking to three cells at the right
    edge. `down` flips the axis: the value grows downwards, which is what the
    fan speeds below the centre axis need.
    """
    grid = [[0] * max(width, 0) for _ in range(max(height, 0))]
    mean = [[0] * max(width, 0) for _ in range(max(height, 0))]
    if width <= 0 or height <= 0:
        return grid, mean
    subs = 2 if braille else 1
    slots = width * subs
    per = max(1, int(repeat))
    data = list(cols)[-max(1, slots // per) :]
    py = height * 4 if braille else height
    span = ymax - ymin

    def row_of(v: float) -> int:
        t = clamp((v - ymin) / span if span > 0 else 0.5, 0.0, 1.0)
        return int(round((t if down else 1.0 - t) * (py - 1)))

    offset = slots - len(data) * per  # the newest bucket touches the right edge
    for i, b in enumerate(data):
        top, bot, avg = row_of(b.hi), row_of(b.lo), row_of(b.avg)
        if top > bot:
            top, bot = bot, top  # with `down` the extremes swap places
        for s in range(per):
            pos = offset + i * per + s
            if not 0 <= pos < slots:
                continue  # bucket wider than the panel - draw as much as fits
            col, sub = divmod(pos, subs)
            if band:
                for rd in range(top, bot + 1):
                    _dot(grid, rd, col, sub, braille)
            _dot(grid, avg, col, sub, braille)
            _dot(mean, avg, col, sub, braille)
    return grid, mean


def render_cells(grid, mean, braille: bool = True) -> tuple[list[str], list[list[int]]]:
    """Masks -> (the rows to draw, the columns carrying the mean).

    The rows already hold the band and the mean composed into one character;
    the column list only says which cells should be overpainted with the mean
    colour, so the line stays visible inside the band.
    """
    rows: list[str] = []
    marks: list[list[int]] = []
    for y, line in enumerate(grid):
        if braille:
            rows.append("".join(chr(0x2800 + c) for c in line))
        else:
            rows.append(
                "".join(
                    ASCII_MEAN if mean[y][x] else (ASCII_FILL if c else " ")
                    for x, c in enumerate(line)
                )
            )
        marks.append([x for x, m in enumerate(mean[y]) if m])
    return rows, marks


def band_area(
    cols, width: int, height: int, ymin: float, ymax: float, repeat: int = 1,
    braille: bool = True, band: bool = True, down: bool = False,
) -> tuple[list[str], list[list[int]]]:
    """The min-max band as a fill + the mean line, ready to be drawn."""
    grid, mean = cell_grid(
        cols, width, height, ymin, ymax, repeat, band=band, braille=braille, down=down
    )
    return render_cells(grid, mean, braille)


def merge_layers(layers, width: int, height: int) -> tuple[list, list]:
    """Composes the series of the dual-axis panel: (masks, cell owner).

    The dots add up (intersections stay visible), but the cell colour belongs
    to the series that came last - the layer order is the drawing order.
    """
    grid = [[0] * width for _ in range(height)]
    owner = [[-1] * width for _ in range(height)]
    for idx, layer in layers:
        for y in range(height):
            row = layer[y]
            for x in range(width):
                if row[x]:
                    grid[y][x] |= row[x]
                    owner[y][x] = idx
    return grid, owner


