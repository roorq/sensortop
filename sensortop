        ("nct6799-isa-0290", "ISA adapter", "temp3", "temp", 0, None, None, False),
    ]

    # labels that copy the reading of another chip (duplicate measurements)
    MIRRORS = {("nct6799-isa-0290", "TSI0_TEMP"): ("k10temp-pci-00c3", "Tctl")}
    # labels that always report a read error
    BROKEN = {("nct6799-isa-0290", "temp3")}

    def __init__(self) -> None:
        self.state = {i: float(s[4]) for i, s in enumerate(self.SPEC)}
        self.t = 0.0

    def available(self) -> Optional[str]:
        return None

    def read(self) -> list[Reading]:
        self.t += 0.35
        out = []
        for i, (chip, ad, label, kind, base, high, crit, static) in enumerate(self.SPEC):
            if static:
                v = float(base)
            else:
                span = abs(base) * 0.25 or 1.0
                wave = math.sin(self.t + i) * span * 0.35
                self.state[i] += random.uniform(-span * 0.08, span * 0.08)
                self.state[i] = max(base * 0.75, min(base * 1.35, self.state[i]))
                v = self.state[i] + wave
            broken = (chip, label) in self.BROKEN
            out.append(
                Reading(
                    chip=chip,
                    adapter=ad,
                    label=label,
                    kind=kind,
                    value=float("nan") if broken else round(v, 3 if kind == "in" else 1),
                    high=high,
                    crit=crit,
                    unit=KIND_UNITS.get(kind, ""),
                    error="I/O error" if broken else None,
                )
            )
        by_key = {(r.chip, r.label): r for r in out}
        for dst, src in self.MIRRORS.items():
            if dst in by_key and src in by_key:
                by_key[dst].value = by_key[src].value
        return out


def sane_limit(kind: str, v: Optional[float]) -> Optional[float]:
    """Rejects nonsense limits (e.g. NVMe reports temp2_max = 65261 °C)."""
    if v is None:
        return None
    if kind == "temp" and not (-50.0 <= v <= 250.0):
        return None
    if kind == "in" and not (-50.0 <= v <= 50.0):
        return None
    return v


def kind_from(key: str) -> str:
    """Sensor kind from the hwmon key prefix: temp1_input -> temp."""
    m = re.match(r"[a-z]+", key)
    return m.group(0) if m else "temp"


def _isnum(v) -> bool:
    return isinstance(v, (int, float)) and not isinstance(v, bool) and not math.isnan(v)


# ---------------------------------------------------------------------------
# Fixed reference points from /sys - independent of the session length
# ---------------------------------------------------------------------------


class SysfsRefs:
    """Reads the values from hwmon/DRM that `sensors` does not expose.

    Scaling a bar against the range observed during the session is useless with
    only a few samples (min == max, every bar full), so the upper reference
    comes from the hardware: power1_cap, pp_dpm_sclk/mclk, fan*_max.
    """

    FREQ_FILES = {
        "sclk": "pp_dpm_sclk",
        "mclk": "pp_dpm_mclk",
        "fclk": "pp_dpm_fclk",
        "socclk": "pp_dpm_socclk",
    }

    def __init__(self, root: str = "/sys/class/hwmon"):
        self.root = root
        self._chips: Optional[dict[str, str]] = None
        self._by_name: dict[str, list[str]] = {}
        self._cache: dict[tuple, Optional[float]] = {}

    # -- mapping lm-sensors names onto hwmon directories --------------------

    def chips(self) -> dict[str, str]:
        if self._chips is None:
            self._chips, self._by_name = self._scan()
        return self._chips

    def _scan(self) -> tuple[dict[str, str], dict[str, list[str]]]:
        chips: dict[str, str] = {}
        by_name: dict[str, list[str]] = {}
        try:
            entries = sorted(os.listdir(self.root))
        except OSError:
            return chips, by_name
        for entry in entries:
            path = os.path.join(self.root, entry)
            name = _read_text(os.path.join(path, "name"))
            if not name:
                continue
            by_name.setdefault(name, []).append(path)
            chip_id = self._chip_id(path, name)
            if chip_id:
                chips[chip_id] = path
        return chips, by_name

    @staticmethod
    def _chip_id(path: str, name: str) -> Optional[str]:
        """Rebuilds the lm-sensors style name: amdgpu + 0000:03:00.0 -> amdgpu-pci-0300."""
        dev = os.path.realpath(os.path.join(path, "device"))
        parts = dev.split(os.sep)
        for comp in reversed(parts):
            m = re.match(r"^[0-9a-f]{4}:([0-9a-f]{2}):([0-9a-f]{2})\.([0-9a-f])$", comp)
            if m:
                bus = int(m.group(1), 16)
                slot, fn = int(m.group(2), 16), int(m.group(3), 16)
                return f"{name}-pci-{bus:02x}{(slot << 3 | fn):02x}"
            m = re.match(r"^(\d+)-([0-9a-f]{4})$", comp)
            if m:
                return f"{name}-i2c-{int(m.group(1))}-{m.group(2)[-2:]}"
        return None

    def path_for(self, chip: str) -> Optional[str]:
        chips = self.chips()
        if chip in chips:
            return chips[chip]
        # ISA/platform (nct6799-isa-0290) has no address to rebuild - it can be
        # matched by name, but only among the directories that could not be
        # identified exactly (otherwise amdgpu-pci-0e00 would hit 0300)
        base = chip.split("-")[0]
        mapped = set(chips.values())
        unmapped = [p for p in self._by_name.get(base, []) if p not in mapped]
        return unmapped[0] if len(unmapped) == 1 else None

    # -- the individual references -----------------------------------------

    def _cached(self, key: tuple, fn) -> Optional[float]:
        if key not in self._cache:
            try:
                self._cache[key] = fn()
            except (OSError, ValueError):
                self._cache[key] = None
        return self._cache[key]

    def fan_max(self, chip: str, label: str) -> Optional[float]:
        def read() -> Optional[float]:
            path = self.path_for(chip)
            if not path:
                return None
            # fanN_label lets us match the label to the input number
            for f in sorted(os.listdir(path)):
                m = re.match(r"^(fan\d+)_max$", f)
                if not m:
                    continue
                lab = _read_text(os.path.join(path, f"{m.group(1)}_label"))
                if lab == label or m.group(1) == label:
                    v = _read_float(os.path.join(path, f))
                    return v if v and v > 0 else None
            return None

        return self._cached(("fan", chip, label), read)

    def power_cap(self, chip: str) -> Optional[float]:
        def read() -> Optional[float]:
            path = self.path_for(chip)
            if not path:
                return None
            for f in ("power1_cap", "power1_cap_max", "power1_max"):
                v = _read_float(os.path.join(path, f))
                if v and v > 0:
                    return v / 1e6  # microwatts -> watts
            return None

        return self._cached(("power", chip), read)

    def freq_top(self, chip: str, label: str) -> Optional[float]:
        """The top entry of pp_dpm_sclk / pp_dpm_mclk (e.g. '2: 2100Mhz *')."""

        def read() -> Optional[float]:
            fname = self.FREQ_FILES.get(label.lower())
            path = self.path_for(chip)
            if not fname or not path:
                return None
            dev = os.path.realpath(os.path.join(path, "device"))
            raw = _read_text(os.path.join(dev, fname))
            if not raw:
                return None
            best = 0.0
            for line in raw.splitlines():
                m = re.search(r"(\d+(?:\.\d+)?)\s*(M|G|k)?hz", line, re.I)
                if m:
                    mult = {"m": 1e6, "g": 1e9, "k": 1e3}.get(
                        (m.group(2) or "M").lower(), 1e6
                    )
                    best = max(best, float(m.group(1)) * mult)
            return best or None

        return self._cached(("freq", chip, label), read)


def _read_text(path: str) -> str:
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def _read_float(path: str) -> Optional[float]:
    raw = _read_text(path)
    try:
        return float(raw)
    except ValueError:
        return None


