def ellipsis(s: str, width: int) -> str:
    """Trims text to the given width, appending an ellipsis character."""
    if width <= 0:
        return ""
    return s if len(s) <= width else s[: width - 1] + "…"


def safe_addstr(win, y: int, x: int, s: str, attr: int = 0) -> None:
    """An addstr that does not blow up at the edges of the screen."""
    if y < 0 or x < 0:
        return
    h, w = win.getmaxyx()
    if y >= h or x >= w:
        return
    s = s[: w - x]
    try:
        win.addstr(y, x, s, attr)
    except curses.error:
        pass  # the last cell of the screen - curses always protests
    except UnicodeError:
        # the locale cannot handle this character: a gap beats an exception in the draw loop
        try:
            win.addstr(y, x, s.encode("ascii", "replace").decode("ascii"), attr)
        except curses.error:
            pass


def draw_box(win, y, x, h, w, title, theme, title_attr=None) -> None:
    if h < 2 or w < 2:
        return
    fr = theme.c(P_FRAME)
    safe_addstr(win, y, x, "╭" + "─" * (w - 2) + "╮", fr)
    for i in range(1, h - 1):
        safe_addstr(win, y + i, x, "│", fr)
        safe_addstr(win, y + i, x + w - 1, "│", fr)
    safe_addstr(win, y + h - 1, x, "╰" + "─" * (w - 2) + "╯", fr)
    if title and w > 8:
        t = ellipsis(f" {title} ", w - 4)
        safe_addstr(win, y, x + 2, t, title_attr or theme.c(P_TITLE) | curses.A_BOLD)


def draw_bar(win, y, x, width, ratio, theme, empty_char="·", palette="heat") -> None:
    """A bar with a horizontal gradient (as in btop) + partial block characters."""
    if width <= 0:
        return
    filled = clamp(ratio, 0, 1) * width
    full = int(filled)
    frac = filled - full
    for i in range(width):
        t = i / max(width - 1, 1)
        if i < full:
            ch, attr = "█", theme.grad(t, palette)
        elif i == full and frac > 0.12:
            # min. 1: BLOCKS[0] is a space, which punches a hole in the bar
            ch, attr = BLOCKS[max(1, int(frac * 8))], theme.grad(t, palette)
        else:
            ch, attr = empty_char, theme.c(P_FRAME)
        safe_addstr(win, y, x + i, ch, attr)


